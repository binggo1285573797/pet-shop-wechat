/* custom-tab-bar/index.wxss */

.custom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 160rpx; /* h-20 roughly = 80px=160rpx, design has pb-8, h-20 */
  z-index: 999;
  pointer-events: none; /* Let clicks pass through empty spaces if any, though blur is solid here */
  display: flex;
  align-items: flex-end; /* Align bottom */
}

.tab-bar-inner {
  width: 100%;
  padding: 24rpx 32rpx 32rpx; /* px-4 pt-3 pb-8 approx */
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(40px);
  box-shadow: 0 -16rpx 48rpx rgba(0, 0, 0, 0.04);
  border-radius: 96rpx 96rpx 0 0; /* rounded-t-[48px] = 96rpx */
  display: flex;
  justify-content: space-around;
  align-items: center;
  pointer-events: auto;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s;
}

.tab-item:active {
  transform: scale(0.9);
}

.tab-item-content {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #a8a29e; /* stone-400 */
  border-radius: 48rpx;
  padding: 8rpx 0;
  transition: all 0.2s;
  min-width: 120rpx;
}

.tab-item-content.active-content {
  color: #FF8A65;
  background: rgba(255, 138, 101, 0.1);
  padding: 8rpx 32rpx;
}

.tab-icon {
  font-family: 'Material Symbols Outlined', sans-serif;
  font-size: 48rpx; /* text-[26px] approx 52rpx, 48rpx looks good */
  transition: all 0.2s;
}

.icon-fill {
  font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
}

.tab-label {
  font-size: 22rpx; /* text-[11px] */
  font-weight: 600;
  font-family: "Plus Jakarta Sans", sans-serif;
  margin-top: 4rpx;
}

.badge {
  position: absolute;
  top: -8rpx;
  right: -16rpx;
  background: #ba1a1a;
  border-radius: 20rpx;
  padding: 0 8rpx;
  min-width: 28rpx;
  height: 28rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border: 2rpx solid #fff;
}

.badge-text {
  color: white;
  font-size: 16rpx;
  font-weight: bold;
}
