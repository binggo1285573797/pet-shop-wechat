/* pages/profile/info/info.wxss - 基于Stitch设计 */
.info-page {
  width: 100vw;
  min-height: 100vh;
  background: #fdfbf9;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* TopAppBar */
.app-header {
  position: fixed;
  top: 0;
  width: 100%;
  height: 96rpx;
  background: #ffffff;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  padding-top: env(safe-area-inset-top);
  border-bottom: 1rpx solid rgba(255, 138, 101, 0.1);
}

.header-row {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.back-icon {
  font-size: 44rpx;
  color: #ff8a65;
}

.header-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1c1c;
  font-family: "Plus Jakarta Sans", sans-serif;
  text-align: center;
}

.header-spacer {
  width: 80rpx;
}

/* Info Scroll */
.info-scroll {
  flex: 1;
  margin-top: 96rpx;
  height: calc(100vh - 96rpx);
}

.info-container {
  padding: 48rpx 32rpx 60rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  max-width: 750rpx;
  margin: 0 auto;
}

/* Avatar Card */
.avatar-card {
  background: #ffffff;
  border-radius: 48rpx;
  padding: 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 24rpx 80rpx rgba(255, 138, 101, 0.06);
  border: 1rpx solid rgba(255, 138, 101, 0.05);
}

.avatar-section {
  position: relative;
  margin-bottom: 16rpx;
}

.avatar-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  background: linear-gradient(135deg, #ff8a65 0%, #ffab91 100%);
  box-shadow: 0 16rpx 48rpx rgba(255, 138, 101, 0.3);
  border: 6rpx solid rgba(255, 255, 255, 0.8);
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-placeholder .material-symbols-outlined {
  font-size: 80rpx;
  color: rgba(255, 255, 255, 0.8);
}

.avatar-change {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.1);
}

.change-icon {
  font-size: 28rpx;
  color: #ff8a65;
}

.avatar-hint {
  font-size: 24rpx;
  color: #89726b;
}

/* Profile Card */
.profile-card {
  background: #ffffff;
  border-radius: 48rpx;
  padding: 32rpx;
  box-shadow: 0 24rpx 80rpx rgba(255, 138, 101, 0.06);
  border: 1rpx solid rgba(255, 138, 101, 0.05);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 24rpx 16rpx;
}

.form-label {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 180rpx;
  flex-shrink: 0;
}

.label-icon {
  font-size: 32rpx;
  color: #ff8a65;
}

.form-label text:last-child {
  font-size: 30rpx;
  font-weight: 600;
  color: #56423c;
}

.form-input {
  flex: 1;
  font-size: 30rpx;
  color: #1a1c1c;
  text-align: right;
}

.input-placeholder {
  color: rgba(137, 114, 107, 0.5);
}

.form-divider {
  height: 1rpx;
  background: rgba(137, 114, 107, 0.1);
  margin: 0 16rpx;
}

/* Password Card */
.password-card {
  background: #ffffff;
  border-radius: 48rpx;
  padding: 32rpx;
  box-shadow: 0 24rpx 80rpx rgba(255, 138, 101, 0.06);
  border: 1rpx solid rgba(255, 138, 101, 0.05);
}

.card-header {
  padding: 0 16rpx 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #56423c;
  font-family: "Plus Jakarta Sans", sans-serif;
}

/* Save Button */
.save-btn {
  background: rgba(137, 114, 107, 0.2);
  color: #89726b;
  padding: 36rpx;
  border-radius: 48rpx;
  text-align: center;
  transition: all 0.3s ease;
}

.save-btn.active {
  background: linear-gradient(135deg, #ff8a65 0%, #ffab91 100%);
  color: #ffffff;
  box-shadow: 0 16rpx 48rpx rgba(255, 138, 101, 0.4);
}

.save-text {
  font-size: 32rpx;
  font-weight: 700;
  font-family: "Plus Jakarta Sans", sans-serif;
}

.bottom-spacer {
  height: 60rpx;
}

/* Decorative Blurs */
.blur-top-left {
  position: fixed;
  top: 25%;
  left: -160rpx;
  width: 320rpx;
  height: 320rpx;
  background: rgba(255, 138, 101, 0.05);
  border-radius: 50%;
  filter: blur(80rpx);
  z-index: -1;
}

.blur-bottom-right {
  position: fixed;
  bottom: 10%;
  right: -200rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255, 138, 101, 0.08);
  border-radius: 50%;
  filter: blur(100rpx);
  z-index: -1;
}
