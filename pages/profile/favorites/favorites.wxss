/* pages/profile/favorites/favorites.wxss - 与社区页面一致的样式 */

Page {
  background: #f9f9f9;
  min-height: 100vh;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 32rpx;
  padding-top: var(--status-bar-height, 44rpx);
  background: rgba(249, 249, 249, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 12rpx 32rpx rgba(159, 65, 34, 0.06);
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.back-btn {
  padding: 8rpx;
}

.back-icon {
  font-size: 40rpx;
  color: #FF8A65;
}

.nav-title {
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: 36rpx;
  font-weight: 800;
  color: #FF8A65;
  letter-spacing: 2rpx;
}

.nav-placeholder {
  width: 56rpx;
}

/* 主内容区 */
.favorites-content {
  padding: calc(var(--status-bar-height, 44rpx) + 104rpx) 24rpx 120rpx;
}

/* 选项卡 */
.tab-container {
  display: flex;
  justify-content: center;
  gap: 60rpx;
  margin-bottom: 24rpx;
  padding: 0 32rpx;
}

.tab-item {
  position: relative;
  padding: 16rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tab-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #999;
  transition: color 0.3s ease;
}

.tab-item.active .tab-text {
  color: #FF8A65;
}

.tab-line {
  position: absolute;
  bottom: 0;
  width: 40rpx;
  height: 4rpx;
  background: linear-gradient(90deg, #FF8A65, #FFB399);
  border-radius: 2rpx;
}

/* 瀑布流布局 */
.waterfall-container {
  display: flex;
  gap: 20rpx;
}

.waterfall-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 帖子卡片 */
.post-card {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.02);
  border: 1rpx solid rgba(221, 192, 184, 0.1);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.post-card:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.post-image {
  width: 100%;
  display: block;
}

/* 无图片时的文字卡片样式 */
.post-text-card {
  width: 100%;
  min-height: 320rpx;
  max-height: 480rpx;
  padding: 56rpx 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

/* 渐变色背景 */
.bg-gradient-1 {
  background: linear-gradient(145deg, #FFF5F0 0%, #FFE8E0 50%, #FFD4C8 100%);
}

.bg-gradient-2 {
  background: linear-gradient(145deg, #FFF8F3 0%, #FFEEE5 50%, #FFE0D4 100%);
}

.bg-gradient-3 {
  background: linear-gradient(145deg, #FDF8F5 0%, #F5EDE8 50%, #EDE0D8 100%);
}

.bg-gradient-4 {
  background: linear-gradient(145deg, #FFFAF7 0%, #FFF0E8 50%, #FFE5D8 100%);
}

.bg-gradient-5 {
  background: linear-gradient(145deg, #F9F5F2 0%, #F0E8E3 50%, #E8DCD4 100%);
}

.bg-gradient-6 {
  background: linear-gradient(145deg, #FFF7F5 0%, #FFEBE5 50%, #FFDDD4 100%);
}

.post-text-content {
  font-size: 30rpx;
  font-weight: 500;
  color: #5A4A42;
  line-height: 1.7;
  text-align: left;
  display: -webkit-box;
  -webkit-line-clamp: 5;
  -webkit-box-orient: vertical;
  overflow: hidden;
  z-index: 1;
  letter-spacing: 0.5rpx;
  width: 100%;
}

.post-text-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(255,255,255,0.4) 0%, rgba(255,255,255,0) 40%, rgba(0,0,0,0.02) 100%);
  pointer-events: none;
}

.post-text-card::before {
  content: '"';
  position: absolute;
  top: 32rpx;
  left: 32rpx;
  font-size: 60rpx;
  color: rgba(159, 65, 34, 0.15);
  font-family: Georgia, serif;
  line-height: 1;
}

.post-text-card::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 80rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(255,255,255,0.6) 100%);
  pointer-events: none;
}

.post-content {
  padding: 24rpx;
}

.post-title {
  font-family: 'Be Vietnam Pro', sans-serif;
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1c1c;
  line-height: 1.5;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.post-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.post-author {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.author-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #ffdbd0;
}

.author-avatar-text {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff8a65 0%, #ffb094 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #ffffff;
  font-weight: 700;
}

.author-name {
  font-size: 24rpx;
  color: #56423c;
  font-weight: 500;
}

.post-price {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.price-symbol {
  font-size: 24rpx;
  color: #FF8A65;
  font-weight: 600;
}

.price-value {
  font-size: 28rpx;
  color: #FF8A65;
  font-weight: 700;
}

.post-likes {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.unfavorite-icon {
  font-size: 36rpx;
  color: #FF8A65;
  font-variation-settings: 'FILL' 1;
}

.unfavorite-icon.active {
  color: #FF8A65;
  font-variation-settings: 'FILL' 1;
}

.like-icon {
  font-size: 36rpx;
  color: #89726b;
  font-variation-settings: 'FILL' 0;
}

.like-icon.active {
  color: #FF8A65;
  font-variation-settings: 'FILL' 1;
}

.like-count {
  font-size: 24rpx;
  color: #89726b;
}

.like-count.active {
  color: #FF8A65;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.paw-loader {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.paw-icon {
  font-size: 48rpx;
  color: #FF8A65;
  opacity: 0.3;
  animation: pawBounce 1.4s ease-in-out infinite;
}

.paw-icon:nth-child(1) { animation-delay: 0s; }
.paw-icon:nth-child(2) { animation-delay: 0.2s; }
.paw-icon:nth-child(3) { animation-delay: 0.4s; }

@keyframes pawBounce {
  0%, 80%, 100% { transform: translateY(0); opacity: 0.3; }
  40% { transform: translateY(-20rpx); opacity: 1; }
}

.loading-text {
  font-size: 26rpx;
  color: #89726b;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  color: #ddc0b8;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 30rpx;
  color: #89726b;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #a8a8a8;
}

/* 底部安全区域 */
.safe-area-bottom {
  height: constant(safe-area-inset-bottom);
  height: env(safe-area-inset-bottom);
}