/* pages/profile/favorites/favorites.wxss - 基于Stitch设计 */
.favorites-page {
  width: 100vw;
  min-height: 100vh;
  background: #fdfbf9;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* TopAppBar */
.app-header {
  position: fixed;
  top: 0;
  width: 100%;
  height: 96rpx;
  background: #ffffff;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  padding-top: env(safe-area-inset-top);
  border-bottom: 1rpx solid rgba(255, 138, 101, 0.1);
}

.header-row {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.back-icon {
  font-size: 44rpx;
  color: #ff8a65;
}

.header-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1c1c;
  font-family: "Plus Jakarta Sans", sans-serif;
  text-align: center;
}

.header-spacer {
  width: 80rpx;
}

/* Favorites Scroll */
.favorites-scroll {
  flex: 1;
  margin-top: 96rpx;
  height: calc(100vh - 96rpx);
}

.favorites-container {
  padding: 48rpx 32rpx 60rpx;
  max-width: 750rpx;
  margin: 0 auto;
}

/* Favorites Grid */
.favorites-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

/* Favorite Card */
.favorite-card {
  background: #ffffff;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 24rpx 80rpx rgba(255, 138, 101, 0.06);
  border: 1rpx solid rgba(255, 138, 101, 0.05);
  transition: all 0.3s ease;
}

.favorite-card:active {
  transform: scale(0.98);
}

.product-img-box {
  width: 100%;
  aspect-ratio: 1;
  background: #f3f3f3;
}

.product-img {
  width: 100%;
  height: 100%;
}

.product-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ff8a65 0%, #ffab91 100%);
}

.product-placeholder .material-symbols-outlined {
  font-size: 64rpx;
  color: rgba(255, 255, 255, 0.5);
}

.product-info {
  padding: 24rpx;
}

.product-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1c1c;
  font-family: "Plus Jakarta Sans", sans-serif;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.product-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.price-symbol {
  font-size: 24rpx;
  font-weight: 700;
  color: #ff8a65;
}

.price-value {
  font-size: 36rpx;
  font-weight: 900;
  color: #ff8a65;
  font-family: "Plus Jakarta Sans", sans-serif;
}

.unfavorite-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 77, 79, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.unfavorite-icon {
  font-size: 28rpx;
  color: #ff4d4f;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.empty-icon-box {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 138, 101, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  color: rgba(255, 138, 101, 0.5);
}

.empty-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #56423c;
  font-family: "Plus Jakarta Sans", sans-serif;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #89726b;
  margin-bottom: 48rpx;
}

.empty-btn {
  background: linear-gradient(135deg, #ff8a65 0%, #ffab91 100%);
  color: #ffffff;
  padding: 24rpx 64rpx;
  border-radius: 64rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 48rpx rgba(255, 138, 101, 0.4);
  font-family: "Plus Jakarta Sans", sans-serif;
}

/* Loading State */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #89726b;
}

/* Decorative Blurs */
.blur-top-right {
  position: fixed;
  top: 15%;
  right: -160rpx;
  width: 320rpx;
  height: 320rpx;
  background: rgba(255, 138, 101, 0.05);
  border-radius: 50%;
  filter: blur(80rpx);
  z-index: -1;
}

.blur-bottom-left {
  position: fixed;
  bottom: 15%;
  left: -200rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255, 138, 101, 0.08);
  border-radius: 50%;
  filter: blur(100rpx);
  z-index: -1;
}
