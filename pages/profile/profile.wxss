/* pages/profile/profile.wxss - 质感优化版 */
.profile-page {
  width: 100vw;
  min-height: 100vh;
  background: linear-gradient(180deg, #faf8f6 0%, #f5f3f0 100%);
  display: flex;
  flex-direction: column;
  position: relative;
}

/* TopAppBar - 渐变背景 */
.app-header {
  position: fixed;
  top: 0;
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #ff9a7b 0%, #ffb4a2 100%);
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  padding-top: env(safe-area-inset-top);
}

.header-row {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  font-family: "Plus Jakarta Sans", sans-serif;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.header-spacer {
  width: 80rpx;
}

/* Scroll Body */
.scroll-body {
  flex: 1;
  margin-top: 96rpx;
  height: calc(100vh - 96rpx);
}

.main-content {
  padding: 24rpx 32rpx 60rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* Hero Section - 精致渐变背景 */
.hero-section {
  position: relative;
  height: 320rpx;
  margin: -24rpx -32rpx 0;
  margin-top: 0;
}

.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100%;
  background: linear-gradient(160deg, #ff9a7b 0%, #ffad96 40%, #ffc4b3 70%, #f8f6f4 100%);
  overflow: hidden;
}

.hero-deco {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
  filter: blur(2rpx);
}

.hero-deco-1 {
  top: -60rpx;
  right: 40rpx;
  width: 220rpx;
  height: 220rpx;
}

.hero-deco-2 {
  bottom: 60rpx;
  right: -40rpx;
  width: 160rpx;
  height: 160rpx;
}

/* Hero User - 质感优化 */
.hero-user {
  position: relative;
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 40rpx;
  padding: 80rpx 48rpx;
  padding-left: 60rpx;
}

.avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

/* 头像外圈光晕 */
.avatar-wrap::before {
  content: '';
  position: absolute;
  top: -8rpx;
  left: -8rpx;
  right: -8rpx;
  bottom: -8rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.4) 0%, rgba(255, 255, 255, 0.1) 100%);
  z-index: -1;
}

.avatar-circle {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 
    0 12rpx 40rpx rgba(0, 0, 0, 0.12),
    0 4rpx 12rpx rgba(0, 0, 0, 0.08),
    inset 0 2rpx 4rpx rgba(255, 255, 255, 0.8);
  border: 4rpx solid rgba(255, 255, 255, 0.9);
  position: relative;
}

/* 头像内发光效果 */
.avatar-circle::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 50%;
  box-shadow: inset 0 2rpx 8rpx rgba(255, 255, 255, 0.5);
  pointer-events: none;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-fallback {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #f5f5f5 0%, #e8e8e8 100%);
}

.avatar-fallback .material-symbols-outlined {
  font-size: 72rpx;
  color: rgba(137, 114, 107, 0.4);
}

/* 编辑按钮 - 精致设计 */
.avatar-edit {
  position: absolute;
  bottom: 4rpx;
  right: 4rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #c45c3e 0%, #d47154 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #ffffff;
  box-shadow: 
    0 4rpx 12rpx rgba(196, 92, 62, 0.4),
    0 2rpx 4rpx rgba(0, 0, 0, 0.1);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.avatar-edit:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 6rpx rgba(196, 92, 62, 0.3);
}

.avatar-edit .material-symbols-outlined {
  font-size: 26rpx;
  color: #ffffff;
}

/* 用户名 - 精致排版 */
.user-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #2d2d2d;
  font-family: "Plus Jakarta Sans", sans-serif;
  letter-spacing: 1rpx;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.05);
}

/* Orders Card - 精致卡片 */
.orders-card {
  background: #ffffff;
  border-radius: 64rpx;
  padding: 36rpx 32rpx;
  box-shadow: 
    0 8rpx 32rpx rgba(255, 138, 101, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1c1c;
  font-family: "Plus Jakarta Sans", sans-serif;
}

.card-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.card-more-text {
  font-size: 24rpx;
  color: #999999;
}

.card-more-icon {
  font-size: 28rpx;
  color: #999999;
}

.order-grid {
  display: flex;
  justify-content: space-between;
}

.order-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
  padding: 8rpx 16rpx;
}

.order-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255, 138, 101, 0.12) 0%, rgba(255, 138, 101, 0.06) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 2rpx 4rpx rgba(255, 255, 255, 0.8);
  transition: transform 0.2s ease;
}

.order-icon:active {
  transform: scale(0.95);
}

.order-icon .material-symbols-outlined {
  font-size: 36rpx;
  color: #ff8a65;
}

.order-label {
  font-size: 24rpx;
  color: #666666;
  font-weight: 500;
}

.order-badge {
  position: absolute;
  top: 2rpx;
  right: 6rpx;
  min-width: 34rpx;
  height: 34rpx;
  padding: 0 10rpx;
  border-radius: 17rpx;
  background: linear-gradient(135deg, #ff4d4f 0%, #ff6b6b 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 6rpx rgba(255, 77, 79, 0.3);
}

.order-badge text {
  font-size: 20rpx;
  font-weight: 700;
  color: #ffffff;
}

/* Menu Card - 精致卡片 */
.menu-card {
  background: #ffffff;
  border-radius: 64rpx;
  padding: 20rpx 32rpx;
  box-shadow: 
    0 8rpx 32rpx rgba(255, 138, 101, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  transition: opacity 0.2s ease;
}

.menu-item:active {
  opacity: 0.7;
}

.menu-left {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.menu-icon {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.06);
}

.menu-icon.location {
  background: linear-gradient(135deg, rgba(255, 138, 101, 0.18) 0%, rgba(255, 138, 101, 0.1) 100%);
}

.menu-icon.favorite {
  background: linear-gradient(135deg, rgba(255, 107, 107, 0.18) 0%, rgba(255, 107, 107, 0.1) 100%);
}

.menu-icon.post {
  background: linear-gradient(135deg, rgba(255, 183, 77, 0.18) 0%, rgba(255, 183, 77, 0.1) 100%);
}

.menu-icon .material-symbols-outlined {
  font-size: 28rpx;
}

.menu-icon.location .material-symbols-outlined {
  color: #ff8a65;
}

.menu-icon.favorite .material-symbols-outlined {
  color: #ff6b6b;
}

.menu-icon.post .material-symbols-outlined {
  color: #ffb74d;
}

.menu-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
}

.menu-arrow {
  font-size: 36rpx;
  color: #cccccc;
}

.menu-divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent 0%, #f0f0f0 20%, #f0f0f0 80%, transparent 100%);
}

/* Logout Button - 精致卡片 */
.logout-btn {
  background: #ffffff;
  border-radius: 64rpx;
  padding: 32rpx;
  text-align: center;
  box-shadow: 
    0 8rpx 32rpx rgba(255, 138, 101, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
  transition: opacity 0.2s ease;
}

.logout-btn:active {
  opacity: 0.7;
}

.logout-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #999999;
}

.bottom-spacer {
  height: 40rpx;
}
