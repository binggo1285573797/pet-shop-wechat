<view class="address-page">
  <!-- 自定义导航栏 -->
  <view class="custom-nav">
    <view class="nav-content">
      <view class="back-btn" bindtap="goBack">
        <text class="material-symbols-outlined back-icon">arrow_back</text>
      </view>
      <text class="nav-title">收货地址</text>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <scroll-view scroll-y class="address-scroll">
    <view class="address-container">
      <!-- Address List -->
      <view class="address-list" wx:if="{{addresses.length > 0}}">
        <view
          class="address-card {{item.isDefault === 1 ? 'default' : ''}}"
          wx:for="{{addresses}}"
          wx:key="id"
          bindtap="{{isSelect ? 'selectAddress' : ''}}"
          data-address="{{item}}"
        >
          <!-- 选中标记 -->
          <view class="select-indicator" wx:if="{{isSelect}}">
            <text class="material-symbols-outlined">check_circle</text>
          </view>

          <!-- 卡片内容区域 -->
          <view class="card-content">
            <view class="address-header">
              <view class="address-user">
                <text class="address-name">{{item.receiverName}}</text>
                <text class="address-phone">{{item.receiverPhone}}</text>
                <view class="default-badge" wx:if="{{item.isDefault === 1}}">
                  <text>默认</text>
                </view>
              </view>
            </view>
            <view class="address-body">
              <text class="address-detail">{{item.address}}</text>
            </view>
            <!-- 设为默认按钮 -->
            <view class="default-action-row" wx:if="{{item.isDefault !== 1 && !isSelect}}">
              <view class="set-default-btn" catchtap="setDefault" data-id="{{item.id}}">
                <text class="material-symbols-outlined default-icon">check_circle</text>
                <text class="default-text">设为默认</text>
              </view>
            </view>
          </view>

          <!-- 操作按钮区域 -->
          <view class="card-actions" wx:if="{{!isSelect}}">
            <view class="action-btn edit-btn" catchtap="editAddress" data-item="{{item}}">
              <text class="material-symbols-outlined action-icon">edit</text>
            </view>
            <view class="action-btn delete-btn" catchtap="deleteAddress" data-id="{{item.id}}">
              <text class="material-symbols-outlined action-icon">delete</text>
            </view>
          </view>

          <!-- Decorative Element -->
          <view class="decorative-plant">
            <text class="material-symbols-outlined plant-icon">potted_plant</text>
          </view>
        </view>
      </view>

      <!-- Empty State -->
      <view class="empty-state" wx:if="{{addresses.length === 0 && !loading}}">
        <view class="empty-icon-box">
          <text class="material-symbols-outlined empty-icon">location_off</text>
        </view>
        <text class="empty-title">还没有收货地址</text>
        <text class="empty-desc">添加收货地址，让商品准确送达</text>
      </view>

      <!-- Loading -->
      <view class="loading-state" wx:if="{{loading}}">
        <view class="loading-spinner"></view>
        <text class="loading-text">加载中...</text>
      </view>

      <!-- Bottom Spacer -->
      <view class="bottom-spacer"></view>
    </view>
  </scroll-view>

  <!-- Sticky Bottom Button -->
  <view class="bottom-button-area">
    <view class="add-address-btn" bindtap="addAddress">
      <text class="material-symbols-outlined btn-icon">add_location_alt</text>
      <text class="btn-text">新增收货地址</text>
    </view>
  </view>
</view>
