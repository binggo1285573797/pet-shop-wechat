/* pages/profile/address/address.wxss - Stitch设计风格优化 */

Page {
  background: #f9f9f9;
}

.address-page {
  width: 100vw;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* ========== 自定义导航栏 ========== */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(249, 249, 249, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  padding-top: var(--status-bar-height, 44rpx);
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 32rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 138, 101, 0.1);
  transition: all 0.2s ease;
}

.back-btn:active {
  background: rgba(255, 138, 101, 0.2);
  transform: scale(0.95);
}

.back-icon {
  font-size: 32rpx;
  color: #FF8A65;
}

.nav-title {
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1c1c;
}

.nav-placeholder {
  width: 72rpx;
}

/* ========== 地址列表滚动区域 ========== */
.address-scroll {
  flex: 1;
  height: 100vh;
  padding-top: calc(var(--status-bar-height, 44rpx) + 88rpx);
}

.address-container {
  padding: 24rpx 32rpx;
  max-width: 750rpx;
  margin: 0 auto;
}

/* ========== 地址卡片列表 ========== */
.address-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ========== 地址卡片 ========== */
.address-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 36rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  position: relative;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  border: 2rpx solid transparent;
  overflow: hidden;
}

.address-card:active {
  transform: scale(0.985);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.02);
}

.address-card.default {
  border-color: rgba(255, 138, 101, 0.15);
  background: linear-gradient(135deg, #ffffff 0%, #fff8f6 100%);
}

/* 选中指示器（选择模式） */
.select-indicator {
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.select-indicator .material-symbols-outlined {
  font-size: 44rpx;
  color: #FF8A65;
}

/* 卡片内容 */
.card-content {
  flex: 1;
  min-width: 0;
}

.address-header {
  margin-bottom: 16rpx;
}

.address-user {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.address-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1c1c;
  font-family: 'Plus Jakarta Sans', sans-serif;
}

.address-phone {
  font-size: 26rpx;
  color: #89726b;
  font-weight: 500;
}

.default-badge {
  background: linear-gradient(135deg, #FF8A65 0%, #FF7043 100%);
  color: #ffffff;
  padding: 6rpx 14rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.address-body {
  padding-right: 16rpx;
}

.address-detail {
  font-size: 28rpx;
  color: #56423c;
  line-height: 1.6;
  font-weight: 400;
}

/* 设为默认按钮 */
.default-action-row {
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #f5f5f5;
}

.set-default-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: rgba(255, 138, 101, 0.08);
  border-radius: 24rpx;
  transition: all 0.2s ease;
}

.set-default-btn:active {
  background: rgba(255, 138, 101, 0.15);
}

.default-icon {
  font-size: 28rpx;
  color: #FF8A65;
}

.default-text {
  font-size: 24rpx;
  color: #FF8A65;
  font-weight: 600;
}

/* 操作按钮 */
.card-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-left: 20rpx;
}

.action-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.action-btn:active {
  transform: scale(0.9);
}

.edit-btn {
  background: #f5f5f5;
}

.edit-btn:active {
  background: #eeeeee;
}

.delete-btn {
  background: #fff2f0;
}

.delete-btn:active {
  background: #ffe0db;
}

.action-icon {
  font-size: 28rpx;
}

.edit-btn .action-icon {
  color: #89726b;
}

.delete-btn .action-icon {
  color: #ff4d4f;
}

/* 装饰植物 */
.decorative-plant {
  position: absolute;
  right: -8rpx;
  bottom: -8rpx;
  opacity: 0.03;
  pointer-events: none;
}

.plant-icon {
  font-size: 120rpx;
  color: #FF8A65;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0;
  gap: 20rpx;
}

.empty-icon-box {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255, 138, 101, 0.08) 0%, rgba(255, 112, 67, 0.04) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.empty-icon {
  font-size: 80rpx;
  color: rgba(255, 138, 101, 0.4);
}

.empty-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1c1c;
  font-family: 'Plus Jakarta Sans', sans-serif;
  margin-bottom: 12rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #89726b;
}

/* ========== 加载状态 ========== */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
  gap: 24rpx;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 4rpx solid #f0f0f0;
  border-top-color: #FF8A65;
  border-radius: 50%;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #89726b;
}

/* ========== 底部间距 ========== */
.bottom-spacer {
  height: 180rpx;
}

/* ========== 底部按钮区域 ========== */
.bottom-button-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: linear-gradient(to top, #f9f9f9 0%, rgba(249, 249, 249, 0.95) 60%, transparent 100%);
  z-index: 50;
}

.add-address-btn {
  background: linear-gradient(135deg, #FF8A65 0%, #FF7043 100%);
  color: #ffffff;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  box-shadow: 0 12rpx 36rpx rgba(255, 138, 101, 0.3);
  transition: all 0.2s ease;
}

.add-address-btn:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 24rpx rgba(255, 138, 101, 0.25);
}

.btn-icon {
  font-size: 36rpx;
  font-variation-settings: 'FILL' 1;
}

.btn-text {
  font-size: 30rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}
