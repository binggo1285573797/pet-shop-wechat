/* pages/profile/address/address.wxss - 基于Stitch设计 */
.address-page {
  width: 100vw;
  min-height: 100vh;
  background: #fdfbf9;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* TopAppBar */
.app-header {
  position: fixed;
  top: 0;
  width: 100%;
  height: 96rpx;
  background: #ffffff;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  padding-top: env(safe-area-inset-top);
  border-bottom: 1rpx solid rgba(255, 138, 101, 0.1);
}

.header-row {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.back-icon {
  font-size: 44rpx;
  color: #ff8a65;
}

.header-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1c1c;
  font-family: "Plus Jakarta Sans", sans-serif;
  text-align: center;
}

.add-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff8a65 0%, #ffab91 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 138, 101, 0.3);
}

.add-icon {
  font-size: 36rpx;
  color: #ffffff;
}

/* Address Scroll */
.address-scroll {
  flex: 1;
  margin-top: 96rpx;
  height: calc(100vh - 96rpx);
}

.address-container {
  padding: 48rpx 32rpx 120rpx;
  max-width: 750rpx;
  margin: 0 auto;
}

/* Address List */
.address-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* Address Card */
.address-card {
  background: #ffffff;
  border-radius: 40rpx;
  padding: 32rpx;
  box-shadow: 0 24rpx 80rpx rgba(255, 138, 101, 0.06);
  border: 1rpx solid rgba(255, 138, 101, 0.05);
}

.address-main {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.address-icon-box {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: rgba(255, 138, 101, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.address-icon {
  font-size: 32rpx;
  color: #ff8a65;
}

.address-info {
  flex: 1;
}

.address-user-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.address-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a1c1c;
  font-family: "Plus Jakarta Sans", sans-serif;
}

.address-phone {
  font-size: 28rpx;
  color: #89726b;
}

.default-badge {
  background: linear-gradient(135deg, #ff8a65 0%, #ffab91 100%);
  color: #ffffff;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  font-size: 20rpx;
  font-weight: 700;
}

.address-detail {
  font-size: 28rpx;
  color: #56423c;
  line-height: 1.5;
}

/* Address Actions */
.address-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(137, 114, 107, 0.1);
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  transition: all 0.3s ease;
}

.action-btn:active {
  transform: scale(0.95);
}

.action-icon {
  font-size: 24rpx;
}

.action-text {
  font-size: 24rpx;
  font-weight: 600;
}

.set-default-btn {
  background: rgba(255, 138, 101, 0.1);
  color: #ff8a65;
}

.edit-btn {
  background: rgba(137, 114, 107, 0.1);
  color: #89726b;
}

.delete-btn {
  background: rgba(255, 77, 79, 0.1);
  color: #ff4d4f;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.empty-icon-box {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 138, 101, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  color: rgba(255, 138, 101, 0.5);
}

.empty-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #56423c;
  font-family: "Plus Jakarta Sans", sans-serif;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #89726b;
  margin-bottom: 48rpx;
}

.empty-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #ff8a65 0%, #ffab91 100%);
  color: #ffffff;
  padding: 24rpx 48rpx;
  border-radius: 64rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 48rpx rgba(255, 138, 101, 0.4);
  font-family: "Plus Jakarta Sans", sans-serif;
}

.btn-icon {
  font-size: 36rpx;
}

/* Loading State */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #89726b;
}

/* FAB Add */
.fab-add {
  position: fixed;
  bottom: 120rpx;
  right: 40rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff8a65 0%, #ffab91 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(255, 138, 101, 0.4);
  z-index: 100;
  transition: all 0.3s ease;
}

.fab-add:active {
  transform: scale(0.9);
}

.fab-icon {
  font-size: 56rpx;
  color: #ffffff;
}

/* Decorative Blurs */
.blur-top-right {
  position: fixed;
  top: 15%;
  right: -160rpx;
  width: 320rpx;
  height: 320rpx;
  background: rgba(255, 138, 101, 0.05);
  border-radius: 50%;
  filter: blur(80rpx);
  z-index: -1;
}

.blur-bottom-left {
  position: fixed;
  bottom: 15%;
  left: -200rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255, 138, 101, 0.08);
  border-radius: 50%;
  filter: blur(100rpx);
  z-index: -1;
}
