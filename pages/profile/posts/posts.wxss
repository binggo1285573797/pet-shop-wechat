/* pages/profile/posts/posts.wxss - 基于Stitch设计 */
.posts-page {
  width: 100vw;
  min-height: 100vh;
  background: #fdfbf9;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* TopAppBar */
.app-header {
  position: fixed;
  top: 0;
  width: 100%;
  height: 96rpx;
  background: #ffffff;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  padding-top: env(safe-area-inset-top);
  border-bottom: 1rpx solid rgba(255, 138, 101, 0.1);
}

.header-row {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.back-icon {
  font-size: 44rpx;
  color: #ff8a65;
}

.header-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1c1c;
  font-family: "Plus Jakarta Sans", sans-serif;
  text-align: center;
}

.header-spacer {
  width: 80rpx;
}

/* Posts Scroll */
.posts-scroll {
  flex: 1;
  margin-top: 96rpx;
  height: calc(100vh - 96rpx);
}

.posts-container {
  padding: 48rpx 32rpx 60rpx;
  max-width: 750rpx;
  margin: 0 auto;
}

/* Posts List */
.posts-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* Post Card */
.post-card {
  background: #ffffff;
  border-radius: 40rpx;
  overflow: hidden;
  box-shadow: 0 24rpx 80rpx rgba(255, 138, 101, 0.06);
  border: 1rpx solid rgba(255, 138, 101, 0.05);
  transition: all 0.3s ease;
}

.post-card:active {
  transform: scale(0.98);
}

/* Post Image */
.post-img-box {
  width: 100%;
  height: 360rpx;
  background: #f3f3f3;
}

.post-img {
  width: 100%;
  height: 100%;
}

/* Post Content */
.post-content {
  padding: 32rpx;
}

.post-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #1a1c1c;
  line-height: 1.6;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.post-meta {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.meta-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.meta-icon {
  font-size: 28rpx;
  color: #89726b;
}

.meta-icon.icon-fill {
  color: #ff8a65;
}

.meta-text {
  font-size: 24rpx;
  color: #89726b;
}

/* Post Actions */
.post-actions {
  display: flex;
  justify-content: flex-end;
  gap: 12rpx;
  padding: 24rpx 32rpx;
  border-top: 1rpx solid rgba(137, 114, 107, 0.1);
}

.action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  border-radius: 20rpx;
  transition: all 0.3s ease;
}

.action-btn:active {
  transform: scale(0.95);
}

.action-icon {
  font-size: 24rpx;
}

.action-text {
  font-size: 24rpx;
  font-weight: 600;
}

.edit-btn {
  background: rgba(137, 114, 107, 0.1);
  color: #89726b;
}

.delete-btn {
  background: rgba(255, 77, 79, 0.1);
  color: #ff4d4f;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.empty-icon-box {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 138, 101, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  color: rgba(255, 138, 101, 0.5);
}

.empty-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #56423c;
  font-family: "Plus Jakarta Sans", sans-serif;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #89726b;
  margin-bottom: 48rpx;
}

.empty-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: linear-gradient(135deg, #ff8a65 0%, #ffab91 100%);
  color: #ffffff;
  padding: 24rpx 48rpx;
  border-radius: 64rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 48rpx rgba(255, 138, 101, 0.4);
  font-family: "Plus Jakarta Sans", sans-serif;
}

.btn-icon {
  font-size: 36rpx;
}

/* Loading State */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #89726b;
}

/* No More State */
.no-more-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 0;
}

.no-more-text {
  font-size: 24rpx;
  color: #89726b;
}

/* Decorative Blurs */
.blur-top-right {
  position: fixed;
  top: 15%;
  right: -160rpx;
  width: 320rpx;
  height: 320rpx;
  background: rgba(255, 138, 101, 0.05);
  border-radius: 50%;
  filter: blur(80rpx);
  z-index: -1;
}

.blur-bottom-left {
  position: fixed;
  bottom: 15%;
  left: -200rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255, 138, 101, 0.08);
  border-radius: 50%;
  filter: blur(100rpx);
  z-index: -1;
}
