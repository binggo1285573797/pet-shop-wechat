/* pages/profile/posts/posts.wxss - 简洁美观的瀑布流布局 */

Page {
  background: #f5f5f5;
  min-height: 100vh;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 32rpx;
  padding-top: var(--status-bar-height, 44rpx);
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 2rpx 20rpx rgba(0, 0, 0, 0.05);
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
}

.back-btn {
  padding: 8rpx;
}

.back-icon {
  font-size: 40rpx;
  color: #333;
}

.nav-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FF8A65 0%, #FF7043 100%);
  border-radius: 50%;
  box-shadow: 0 4rpx 16rpx rgba(255, 112, 67, 0.3);
}

.add-icon {
  font-size: 32rpx;
  color: #ffffff;
}

/* 主内容区 */
.posts-content {
  padding: calc(var(--status-bar-height, 44rpx) + 108rpx) 24rpx 40rpx;
}

/* 瀑布流布局 */
.waterfall-container {
  display: flex;
  gap: 20rpx;
}

.waterfall-column {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

/* 帖子卡片 */
.post-card {
  background: #ffffff;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.post-card:active {
  transform: scale(0.98);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
}

.post-image {
  width: 100%;
  display: block;
}

/* 无图片时的文字卡片样式 */
.post-text-card {
  width: 100%;
  min-height: 240rpx;
  max-height: 360rpx;
  padding: 48rpx 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
}

/* 渐变色背景 */
.bg-gradient-1 {
  background: linear-gradient(145deg, #FFF5F0 0%, #FFE8E0 50%, #FFD4C8 100%);
}

.bg-gradient-2 {
  background: linear-gradient(145deg, #FFF8F3 0%, #FFEEE5 50%, #FFE0D4 100%);
}

.bg-gradient-3 {
  background: linear-gradient(145deg, #FDF8F5 0%, #F5EDE8 50%, #EDE0D8 100%);
}

.bg-gradient-4 {
  background: linear-gradient(145deg, #FFFAF7 0%, #FFF0E8 50%, #FFE5D8 100%);
}

.bg-gradient-5 {
  background: linear-gradient(145deg, #F9F5F2 0%, #F0E8E3 50%, #E8DCD4 100%);
}

.bg-gradient-6 {
  background: linear-gradient(145deg, #FFF7F5 0%, #FFEBE5 50%, #FFDDD4 100%);
}

.post-text-content {
  font-size: 28rpx;
  font-weight: 500;
  color: #5A4A42;
  line-height: 1.6;
  text-align: left;
  display: -webkit-box;
  -webkit-line-clamp: 4;
  -webkit-box-orient: vertical;
  overflow: hidden;
  z-index: 1;
  letter-spacing: 0.5rpx;
  width: 100%;
}

.post-text-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(255,255,255,0.3) 0%, rgba(255,255,255,0) 40%, rgba(0,0,0,0.02) 100%);
  pointer-events: none;
}

.post-text-card::before {
  content: '"';
  position: absolute;
  top: 24rpx;
  left: 24rpx;
  font-size: 48rpx;
  color: rgba(159, 65, 34, 0.12);
  font-family: Georgia, serif;
  line-height: 1;
}

.post-text-card::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 60rpx;
  background: linear-gradient(180deg, transparent 0%, rgba(255,255,255,0.5) 100%);
  pointer-events: none;
}

.post-content {
  padding: 20rpx;
}

.post-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  line-height: 1.5;
  margin-bottom: 16rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.post-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.post-stats {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.stat-icon {
  font-size: 28rpx;
  color: #999;
}

.stat-count {
  font-size: 24rpx;
  color: #999;
}

.post-time {
  font-size: 22rpx;
  color: #bbb;
}

/* 加载状态 */
.loading-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.paw-loader {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.paw-icon {
  font-size: 48rpx;
  color: #FF8A65;
  opacity: 0.3;
  animation: pawBounce 1.4s ease-in-out infinite;
}

.paw-icon:nth-child(1) { animation-delay: 0s; }
.paw-icon:nth-child(2) { animation-delay: 0.2s; }
.paw-icon:nth-child(3) { animation-delay: 0.4s; }

@keyframes pawBounce {
  0%, 80%, 100% { transform: translateY(0); opacity: 0.3; }
  40% { transform: translateY(-20rpx); opacity: 1; }
}

.loading-text {
  font-size: 26rpx;
  color: #999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 120rpx;
  color: #ddd;
  margin-bottom: 32rpx;
}

.empty-title {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 40rpx;
}

.empty-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 48rpx;
  background: linear-gradient(135deg, #FF8A65 0%, #FF7043 100%);
  border-radius: 40rpx;
  box-shadow: 0 12rpx 32rpx rgba(255, 112, 67, 0.25);
}

.empty-btn .btn-icon {
  font-size: 32rpx;
  color: #ffffff;
}

.empty-btn text {
  font-size: 28rpx;
  color: #ffffff;
  font-weight: 600;
}

/* 底部安全区域 */
.safe-area-bottom {
  height: constant(safe-area-inset-bottom);
  height: env(safe-area-inset-bottom);
}
