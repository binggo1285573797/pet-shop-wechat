<!--pages/profile/posts/posts.wxml - 简洁美观的瀑布流布局-->
<view class="posts-page">
  <!-- 自定义导航栏 -->
  <view class="custom-nav">
    <view class="nav-content">
      <view class="back-btn" bindtap="goBack">
        <text class="material-symbols-outlined back-icon">arrow_back</text>
      </view>
      <text class="nav-title">我的帖子</text>
      <view class="nav-btn" bindtap="goToPost">
        <text class="material-symbols-outlined add-icon">add</text>
      </view>
    </view>
  </view>

  <!-- 主内容区 -->
  <view class="posts-content">
    <!-- 加载状态 -->
    <view wx:if="{{loading && posts.length === 0}}" class="loading-container">
      <view class="paw-loader">
        <text class="material-symbols-outlined paw-icon">pets</text>
        <text class="material-symbols-outlined paw-icon">pets</text>
        <text class="material-symbols-outlined paw-icon">pets</text>
      </view>
      <text class="loading-text">正在加载帖子...</text>
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{posts.length === 0}}" class="empty-state">
      <text class="material-symbols-outlined empty-icon">article</text>
      <text class="empty-title">还没有发布过帖子</text>
      <text class="empty-desc">快去分享你的萌宠生活吧~</text>
      <view class="empty-btn" bindtap="goToPost">
        <text class="material-symbols-outlined btn-icon">edit</text>
        <text>去发帖</text>
      </view>
    </view>

    <!-- 瀑布流帖子列表 -->
    <view wx:else class="waterfall-container">
      <!-- 左列 -->
      <view class="waterfall-column">
        <block wx:for="{{posts}}" wx:key="id" wx:if="{{index % 2 === 0}}">
          <view class="post-card" bindtap="goToDetail" data-id="{{item.id}}">
            <!-- 有图片的帖子 -->
            <block wx:if="{{item.firstPic}}">
              <image class="post-image" src="{{item.firstPic}}" mode="widthFix" lazy-load/>
            </block>
            <!-- 无图片的帖子 -->
            <block wx:else>
              <view class="post-text-card {{item.bgClass || 'bg-gradient-1'}}">
                <text class="post-text-content">{{item.title || item.content}}</text>
                <view class="post-text-mask"></view>
              </view>
            </block>
            <view class="post-content">
              <text class="post-title">{{item.title || item.content}}</text>
              <view class="post-footer">
                <view class="post-stats">
                  <view class="stat-item">
                    <text class="material-symbols-outlined stat-icon">pets</text>
                    <text class="stat-count">{{item.likeCount || 0}}</text>
                  </view>
                  <view class="stat-item">
                    <text class="material-symbols-outlined stat-icon">chat_bubble</text>
                    <text class="stat-count">{{item.commentCount || 0}}</text>
                  </view>
                </view>
                <text class="post-time">{{item.createTimeText}}</text>
              </view>
            </view>
          </view>
        </block>
      </view>

      <!-- 右列 -->
      <view class="waterfall-column">
        <block wx:for="{{posts}}" wx:key="id" wx:if="{{index % 2 === 1}}">
          <view class="post-card" bindtap="goToDetail" data-id="{{item.id}}">
            <!-- 有图片的帖子 -->
            <block wx:if="{{item.firstPic}}">
              <image class="post-image" src="{{item.firstPic}}" mode="widthFix" lazy-load/>
            </block>
            <!-- 无图片的帖子 -->
            <block wx:else>
              <view class="post-text-card {{item.bgClass || 'bg-gradient-2'}}">
                <text class="post-text-content">{{item.title || item.content}}</text>
                <view class="post-text-mask"></view>
              </view>
            </block>
            <view class="post-content">
              <text class="post-title">{{item.title || item.content}}</text>
              <view class="post-footer">
                <view class="post-stats">
                  <view class="stat-item">
                    <text class="material-symbols-outlined stat-icon">pets</text>
                    <text class="stat-count">{{item.likeCount || 0}}</text>
                  </view>
                  <view class="stat-item">
                    <text class="material-symbols-outlined stat-icon">chat_bubble</text>
                    <text class="stat-count">{{item.commentCount || 0}}</text>
                  </view>
                </view>
                <text class="post-time">{{item.createTimeText}}</text>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <!-- 底部安全区域 -->
    <view class="safe-area-bottom"></view>
  </view>
</view>
