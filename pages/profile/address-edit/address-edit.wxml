<view class="address-edit-page">
  <!-- 自定义导航栏 -->
  <view class="custom-nav">
    <view class="nav-content">
      <view class="back-btn" bindtap="goBack">
        <text class="material-symbols-outlined back-icon">arrow_back</text>
      </view>
      <text class="nav-title">{{editId ? '编辑地址' : '新增地址'}}</text>
      <view class="nav-placeholder"></view>
    </view>
  </view>

  <scroll-view scroll-y class="edit-scroll">
    <view class="edit-container">
      <!-- 页面标题 -->
      <view class="page-header-section">
        <text class="page-subtitle">填写收货信息，让商品准确送达</text>
      </view>

      <!-- Form Card -->
      <view class="form-card">
        <!-- 收货人姓名 -->
        <view class="form-item">
          <view class="form-label">
            <text class="material-symbols-outlined label-icon">person</text>
            <text class="form-label-text">收货人</text>
          </view>
          <input
            class="form-input"
            value="{{form.receiverName}}"
            bindinput="onNameInput"
            placeholder="请输入收货人姓名"
            placeholder-class="input-placeholder"
          />
        </view>
        
        <!-- 手机号 -->
        <view class="form-item">
          <view class="form-label">
            <text class="material-symbols-outlined label-icon">phone</text>
            <text class="form-label-text">手机号码</text>
          </view>
          <input
            class="form-input {{phoneError ? 'error' : ''}}"
            type="number"
            value="{{form.receiverPhone}}"
            bindinput="onPhoneInput"
            bindblur="onPhoneBlur"
            placeholder="请输入收货人手机号"
            placeholder-class="input-placeholder"
            maxlength="11"
          />
          <text class="error-text" wx:if="{{phoneError}}">请输入正确的11位手机号码</text>
        </view>
        
        <!-- 所在地区 -->
        <view class="form-item form-item-picker" bindtap="showRegionPicker">
          <view class="form-label">
            <text class="material-symbols-outlined label-icon">location_on</text>
            <text class="form-label-text">所在地区</text>
          </view>
          <view class="picker-value {{form.region ? 'has-value' : ''}}">
            <text>{{form.region || '请选择省/市/区/街道'}}</text>
            <text class="material-symbols-outlined picker-arrow">chevron_right</text>
          </view>
        </view>
        
        <!-- 详细地址 -->
        <view class="form-item form-item-textarea">
          <view class="form-label">
            <text class="material-symbols-outlined label-icon">home</text>
            <text class="form-label-text">详细地址</text>
          </view>
          <textarea
            class="form-textarea"
            value="{{form.detailAddress}}"
            bindinput="onAddressInput"
            placeholder="请输入街道、门牌号等详细信息"
            placeholder-class="input-placeholder"
            maxlength="200"
          />
        </view>
      </view>

      <!-- Default Switch Card -->
      <view class="switch-card">
        <view class="switch-item">
          <view class="switch-label">
            <text class="material-symbols-outlined switch-icon">star</text>
            <view class="switch-text">
              <text class="switch-title">设为默认地址</text>
              <text class="switch-desc">下单时将优先使用该地址</text>
            </view>
          </view>
          <switch 
            checked="{{form.isDefault === 1}}" 
            bindchange="onDefaultChange" 
            color="#FF8A65"
          />
        </view>
      </view>

      <!-- Save Button -->
      <view class="save-btn {{canSave ? 'active' : ''}}" bindtap="saveAddress">
        <text class="save-text">保存地址</text>
      </view>

      <view class="bottom-spacer"></view>
    </view>
  </scroll-view>

  <!-- Region Picker Popup -->
  <view class="picker-popup {{showPicker ? 'show' : ''}}">
    <view class="picker-mask" bindtap="hideRegionPicker"></view>
    <view class="picker-content">
      <view class="picker-header">
        <text class="picker-cancel" bindtap="hideRegionPicker">取消</text>
        <text class="picker-title">选择地区</text>
        <text class="picker-confirm" bindtap="confirmRegion">确定</text>
      </view>
      <picker-view class="picker-view" value="{{regionValue}}" bindchange="onRegionChange">
        <picker-view-column>
          <view wx:for="{{provinces}}" wx:key="index" class="picker-item">{{item}}</view>
        </picker-view-column>
        <picker-view-column>
          <view wx:for="{{cities}}" wx:key="index" class="picker-item">{{item}}</view>
        </picker-view-column>
        <picker-view-column>
          <view wx:for="{{districts}}" wx:key="index" class="picker-item">{{item}}</view>
        </picker-view-column>
      </picker-view>
    </view>
  </view>

  <!-- Decorative Blurs -->
  <view class="blur-top-right"></view>
  <view class="blur-bottom-left"></view>
</view>
