.page {
  width: 100vw;
  min-height: 100vh;
  background: linear-gradient(180deg, #faf8f6 0%, #f5f3f0 100%);
  position: relative;
}

/* 内容区 */
.content {
  height: 100vh;
  padding: 32rpx;
  box-sizing: border-box;
}

/* 表单卡片 */
.form-card {
  background: #ffffff;
  border-radius: 48rpx;
  padding: 20rpx 32rpx;
  box-shadow: 
    0 8rpx 32rpx rgba(255, 138, 101, 0.08),
    0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  margin-bottom: 40rpx;
  margin-top: 40rpx;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
}

.form-label {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-shrink: 0;
}

.form-icon {
  font-size: 36rpx;
  color: #ff8a65;
}

.label-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #333333;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #333333;
  padding: 8rpx 0 8rpx 16rpx;
  min-width: 0;
}

.form-input.error {
  color: #ff4d4f;
}

.input-placeholder {
  color: #cccccc;
}

.form-divider {
  height: 1rpx;
  background: linear-gradient(90deg, transparent 0%, #f0f0f0 20%, #f0f0f0 80%, transparent 100%);
}

/* 错误提示 */
.error-row {
  padding: 12rpx 0;
}

.error-text {
  font-size: 24rpx;
  color: #ff4d4f;
  text-align: right;
  display: block;
}

/* 提交按钮 */
.submit-btn {
  background: linear-gradient(135deg, rgba(255, 138, 101, 0.3) 0%, rgba(255, 138, 101, 0.2) 100%);
  border-radius: 48rpx;
  padding: 32rpx;
  text-align: center;
  box-shadow: 
    0 4rpx 16rpx rgba(255, 138, 101, 0.08);
  transition: all 0.3s ease;
}

.submit-btn.active {
  background: linear-gradient(135deg, #ff9a7b 0%, #ffb4a2 100%);
  box-shadow: 
    0 8rpx 24rpx rgba(255, 154, 123, 0.3),
    0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.submit-btn:active {
  transform: scale(0.98);
}

.submit-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.bottom-spacer {
  height: 80rpx;
}

/* 装饰元素 */
.blur-top-left {
  position: fixed;
  top: 200rpx;
  left: -100rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(255, 154, 123, 0.08) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}

.blur-bottom-right {
  position: fixed;
  bottom: -100rpx;
  right: -100rpx;
  width: 400rpx;
  height: 400rpx;
  background: radial-gradient(circle, rgba(255, 183, 77, 0.08) 0%, transparent 70%);
  pointer-events: none;
  z-index: 0;
}
