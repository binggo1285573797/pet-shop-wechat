<view class="page">
  <scroll-view scroll-y class="content">
    <!-- 表单卡片 -->
    <view class="form-card">
      <!-- 原密码 -->
      <view class="form-item">
        <view class="form-label">
          <text class="material-symbols-outlined form-icon">lock_outline</text>
          <text class="label-text">原密码</text>
        </view>
        <input
          class="form-input"
          type="password"
          value="{{oldPassword}}"
          bindinput="onOldPasswordInput"
          placeholder="请输入原密码"
          placeholder-class="input-placeholder"
          password
        />
      </view>

      <view class="form-divider"></view>

      <!-- 新密码 -->
      <view class="form-item">
        <view class="form-label">
          <text class="material-symbols-outlined form-icon">lock</text>
          <text class="label-text">新密码</text>
        </view>
        <input
          class="form-input {{newPasswordError ? 'error' : ''}}"
          type="password"
          value="{{newPassword}}"
          bindinput="onNewPasswordInput"
          placeholder="请输入新密码（至少6位）"
          placeholder-class="input-placeholder"
          password
        />
      </view>

      <view class="form-divider"></view>

      <!-- 确认新密码 -->
      <view class="form-item">
        <view class="form-label">
          <text class="material-symbols-outlined form-icon">lock_reset</text>
          <text class="label-text">确认新密码</text>
        </view>
        <input
          class="form-input {{confirmError ? 'error' : ''}}"
          type="password"
          value="{{confirmPassword}}"
          bindinput="onConfirmPasswordInput"
          placeholder="请再次输入新密码"
          placeholder-class="input-placeholder"
          password
        />
      </view>

      <!-- 错误提示 -->
      <view class="error-row" wx:if="{{newPasswordError}}">
        <text class="error-text">{{newPasswordMsg}}</text>
      </view>
      <view class="error-row" wx:if="{{confirmError}}">
        <text class="error-text">{{confirmMsg}}</text>
      </view>
    </view>

    <!-- 提交按钮 -->
    <view class="submit-btn {{canSubmit ? 'active' : ''}}" bindtap="submitChange">
      <text class="submit-text">确认修改</text>
    </view>

    <view class="bottom-spacer"></view>
  </scroll-view>

  <!-- 装饰元素 -->
  <view class="blur-top-left"></view>
  <view class="blur-bottom-right"></view>
</view>
