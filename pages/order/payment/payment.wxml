<!--pages/order/payment/payment.wxml-->
<view class="payment-page">
  <view class="payment-content" wx:if="{{order}}">
    <!-- 订单信息 -->
    <view class="order-card">
      <view class="card-title">订单信息</view>
      <view class="order-row">
        <text class="order-label">订单号</text>
        <text class="order-value">{{order.orderSn}}</text>
      </view>
      <view class="order-row">
        <text class="order-label">店铺</text>
        <text class="order-value">{{order.shopName}}</text>
      </view>
      <view class="order-row">
        <text class="order-label">商品</text>
        <text class="order-value">{{order.productNames}}</text>
      </view>
      <view class="order-row">
        <text class="order-label">实付金额</text>
        <text class="order-amount">¥{{order.totalAmount}}</text>
      </view>
    </view>

    <!-- 支付方式选择 -->
    <view class="method-card">
      <view class="card-title">选择支付方式</view>
      
      <view class="pay-method-item {{selectedMethod === 'wechat' ? 'active' : ''}}" bindtap="selectMethod" data-method="wechat">
        <view class="method-left">
          <view class="method-icon wechat-icon">
            <text class="method-icon-text">微</text>
          </view>
          <text class="method-name">微信支付</text>
        </view>
        <view class="method-right">
          <text class="check-icon" wx:if="{{selectedMethod === 'wechat'}}">✓</text>
          <view class="radio-circle" wx:else>
            <view class="radio-dot"></view>
          </view>
        </view>
      </view>

      <view class="pay-method-item {{selectedMethod === 'alipay' ? 'active' : ''}}" bindtap="selectMethod" data-method="alipay">
        <view class="method-left">
          <view class="method-icon alipay-icon">
            <text class="method-icon-text">支</text>
          </view>
          <text class="method-name">支付宝</text>
        </view>
        <view class="method-right">
          <text class="check-icon" wx:if="{{selectedMethod === 'alipay'}}">✓</text>
          <view class="radio-circle" wx:else>
            <view class="radio-dot"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 底部占位 -->
    <view class="bottom-spacer"></view>
  </view>

  <!-- 底部支付按钮 -->
  <view class="bottom-bar" wx:if="{{order}}">
    <view class="total-info">
      <text class="total-label">实付</text>
      <view class="total-price">
        <text class="price-symbol">¥</text>
        <text class="price-value">{{order.totalAmount}}</text>
      </view>
    </view>
    <view class="pay-btn pay-btn-active" bindtap="handlePay">
      <text>确认支付</text>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-box" wx:if="{{!order}}">
    <text>加载中...</text>
  </view>
</view>
