/* pages/order/refund/refund.wxss */
.refund-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff8f5 0%, #ffffff 100%);
  padding-bottom: 160rpx;
}

/* Header */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 24rpx 24rpx;
  background: linear-gradient(135deg, #ff8a65 0%, #ff7043 100%);
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.2);
}

.back-btn .material-symbols-outlined {
  font-size: 32rpx;
  color: #fff;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
}

.header-placeholder {
  width: 64rpx;
}

/* Section Card */
.section-card {
  margin: 24rpx;
  padding: 24rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 138, 101, 0.08);
}

.section-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #f5f5f5;
}

/* Order Info */
.order-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-bottom: 20rpx;
}

.order-sn {
  font-size: 26rpx;
  color: #999;
}

.order-amount {
  font-size: 28rpx;
  color: #ff7043;
  font-weight: 600;
}

/* Product List */
.product-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.product-item {
  display: flex;
  gap: 16rpx;
  padding: 16rpx;
  background: #fafafa;
  border-radius: 12rpx;
}

.product-img-box {
  width: 120rpx;
  height: 120rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #f0f0f0;
}

.product-img {
  width: 100%;
  height: 100%;
}

.product-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-placeholder .material-symbols-outlined {
  font-size: 48rpx;
  color: #ccc;
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.product-name {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-price-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.price-symbol {
  font-size: 24rpx;
  color: #ff7043;
}

.price-value {
  font-size: 32rpx;
  color: #ff7043;
  font-weight: 700;
}

.product-qty {
  font-size: 24rpx;
  color: #999;
  margin-left: auto;
}

/* Form Item */
.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 16rpx;
}

.form-label.required::after {
  content: '*';
  color: #ff5252;
  margin-left: 8rpx;
}

/* Picker */
picker {
  width: 100%;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #333;
}

.picker-value.placeholder {
  color: #999;
}

.picker-arrow {
  font-size: 32rpx;
  color: #999;
}

/* Amount Input */
.amount-input-box {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #f8f8f8;
  border-radius: 12rpx;
}

/* Amount Display (只读显示) */
.amount-display-box {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: #fff5f2;
  border-radius: 12rpx;
  border: 2rpx solid #ffe8e0;
}

.amount-symbol {
  font-size: 32rpx;
  color: #ff7043;
  font-weight: 700;
  margin-right: 16rpx;
}

.amount-value {
  flex: 1;
  font-size: 36rpx;
  color: #ff7043;
  font-weight: 700;
}

.amount-input {
  flex: 1;
  font-size: 32rpx;
  color: #333;
  height: 48rpx;
}

.amount-hint {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
}

/* Upload Section */
.upload-section {
  margin-top: 16rpx;
}

.upload-list {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.upload-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.upload-img {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(0, 0, 0, 0.5);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-btn .material-symbols-outlined {
  font-size: 24rpx;
  color: #fff;
}

.upload-btn {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ddd;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafafa;
}

.upload-icon {
  font-size: 48rpx;
  color: #ccc;
  margin-bottom: 12rpx;
}

.upload-text {
  font-size: 24rpx;
  color: #999;
}

.upload-hint {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 16rpx;
}

/* Tips Card */
.tips-card {
  margin: 24rpx;
  padding: 24rpx;
  background: #fff9f5;
  border-radius: 16rpx;
  border: 2rpx solid #ffe8e0;
}

.tips-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #ff7043;
  margin-bottom: 16rpx;
}

.tips-item {
  display: block;
  font-size: 26rpx;
  color: #666;
  line-height: 1.8;
}

/* Submit Section */
.submit-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 32rpx 40rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, rgba(255,255,255,0) 0%, rgba(255,255,255,0.95) 20%, #fff 100%);
  backdrop-filter: blur(10px);
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #ff8a65 0%, #ff7043 50%, #ff5722 100%);
  color: #fff;
  font-size: 34rpx;
  font-weight: 700;
  border-radius: 48rpx;
  border: none;
  box-shadow: 0 8rpx 32rpx rgba(255, 138, 101, 0.4), 0 4rpx 16rpx rgba(255, 112, 67, 0.3);
  position: relative;
  overflow: hidden;
  transition: all 0.3s ease;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn::after {
  border: none;
}

/* 按钮光泽效果 */
.submit-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
  transition: left 0.5s ease;
}

.submit-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(255, 138, 101, 0.3);
}

.submit-btn:active::before {
  left: 100%;
}

.submit-btn.disabled {
  opacity: 0.5;
  background: linear-gradient(135deg, #ccc 0%, #999 100%);
  box-shadow: none;
}

/* Loading State */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 200rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}
