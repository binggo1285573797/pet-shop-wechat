<!--pages/order/refund/refund.wxml-->
<view class="refund-page">
  <!-- Header -->
  <view class="header">
    <view class="back-btn" bindtap="goBack">
      <text class="material-symbols-outlined">arrow_back</text>
    </view>
    <text class="header-title">申请退款</text>
    <view class="header-placeholder"></view>
  </view>

  <view wx:if="{{order}}">
    <!-- 订单信息 -->
    <view class="section-card">
      <view class="section-title">订单信息</view>
      <view class="order-info">
        <text class="order-sn">订单号：{{order.orderSn}}</text>
        <text class="order-amount">订单金额：¥{{order.totalAmount}}</text>
      </view>
      <!-- 商品列表 -->
      <view class="product-list">
        <view class="product-item" wx:for="{{items}}" wx:key="id">
          <view class="product-img-box">
            <image wx:if="{{item.productPic}}" src="{{item.productPic}}" mode="aspectFill" class="product-img" />
            <view wx:else class="product-placeholder">
              <text class="material-symbols-outlined">pets</text>
            </view>
          </view>
          <view class="product-info">
            <text class="product-name">{{item.productName}}</text>
            <view class="product-price-row">
              <text class="price-symbol">¥</text>
              <text class="price-value">{{item.productPrice}}</text>
              <text class="product-qty">× {{item.quantity}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>

    <!-- 退款信息 -->
    <view class="section-card">
      <view class="section-title">退款信息</view>
      
      <!-- 退款原因 -->
      <view class="form-item">
        <view class="form-label required">退款原因</view>
        <picker mode="selector" range="{{reasonOptions}}" value="{{selectedReasonIndex}}" bindchange="onReasonChange">
          <view class="picker-value {{form.reason ? '' : 'placeholder'}}">
            {{form.reason || '请选择退款原因'}}
            <text class="material-symbols-outlined picker-arrow">chevron_right</text>
          </view>
        </picker>
      </view>

      <!-- 退款金额 -->
      <view class="form-item">
        <view class="form-label required">退款金额</view>
        <view class="amount-display-box">
          <text class="amount-symbol">¥</text>
          <text class="amount-value">{{order.totalAmount}}</text>
        </view>
      </view>

      <!-- 上传凭证 -->
      <view class="form-item">
        <view class="form-label">上传凭证（选填）</view>
        <view class="upload-section">
          <view class="upload-list">
            <!-- 已上传图片 -->
            <view class="upload-item" wx:for="{{form.proofPics}}" wx:key="*this">
              <image src="{{item}}" mode="aspectFill" class="upload-img" bindtap="previewImage" data-url="{{item}}" />
              <view class="delete-btn" catchtap="deleteImage" data-index="{{index}}">
                <text class="material-symbols-outlined">close</text>
              </view>
            </view>
            <!-- 上传按钮 -->
            <view class="upload-btn" wx:if="{{form.proofPics.length < 3}}" bindtap="uploadImage">
              <text class="material-symbols-outlined upload-icon">add_photo_alternate</text>
              <text class="upload-text">{{uploading ? '上传中...' : '上传图片'}}</text>
            </view>
          </view>
          <text class="upload-hint">最多上传3张图片，支持JPG、PNG格式</text>
        </view>
      </view>
    </view>

    <!-- 提示信息 -->
    <view class="tips-card">
      <text class="tips-title">温馨提示：</text>
      <text class="tips-item">1. 退款申请提交后，商家将在3个工作日内处理</text>
      <text class="tips-item">2. 商家同意退款后，款项将原路退回</text>
    </view>

    <!-- 提交按钮 -->
    <view class="submit-section">
      <button 
        class="submit-btn {{submitting ? 'disabled' : ''}}" 
        bindtap="submitRefund"
        disabled="{{submitting}}"
      >
        {{submitting ? '提交中...' : '提交申请'}}
      </button>
    </view>
  </view>

  <!-- 加载中 -->
  <view class="loading-state" wx:if="{{!order}}">
    <text class="loading-text">加载中...</text>
  </view>
</view>
