<view class="order-list-page">
  <!-- Status Tabs -->
  <view class="status-tabs">
    <scroll-view scroll-x class="tabs-scroll" enhanced show-scrollbar="{{false}}">
      <view class="tabs-container">
        <view
          class="tab-item {{activeStatus === item.value ? 'active' : ''}}"
          wx:for="{{statusTabs}}"
          wx:key="value"
          bindtap="onStatusTap"
          data-value="{{item.value}}"
        >
          <text class="tab-label">{{item.label}}</text>
          <view class="tab-indicator" wx:if="{{activeStatus === item.value}}"></view>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- Order List -->
  <scroll-view
    scroll-y
    class="order-scroll"
    bindscrolltolower="loadMore"
    enable-flex
  >
    <view class="order-list-container">
      <view
        class="order-card"
        wx:for="{{orders}}"
        wx:key="id"
        bindtap="viewDetail"
        data-id="{{item.id}}"
      >
        <!-- Shop Header -->
        <view class="shop-row">
          <view class="shop-icon-box">
            <text class="material-symbols-outlined shop-icon">storefront</text>
          </view>
          <text class="shop-name">{{item.shopName || '未知店铺'}}</text>
          <view class="order-status-badge status-{{item.status}}">
            <text>{{item.statusText}}</text>
          </view>
        </view>

        <!-- Product Items -->
        <view class="product-list">
          <view class="product-item" wx:for="{{item.orderItems}}" wx:for-item="oi" wx:key="id">
            <view class="product-img-box">
              <image wx:if="{{oi.productPic}}" src="{{oi.productPic}}" mode="aspectFill" class="product-img" />
              <view wx:else class="product-placeholder">
                <text class="material-symbols-outlined">pets</text>
              </view>
            </view>
            <view class="product-info">
              <view class="product-name">{{oi.productName}}</view>
              <view class="product-price-row">
                <text class="price-symbol">¥</text>
                <text class="price-value">{{oi.productPrice}}</text>
                <text class="product-qty">× {{oi.quantity}}</text>
              </view>
            </view>
          </view>
        </view>

        <!-- Order Summary -->
        <view class="order-summary">
          <text class="order-time">{{item.createTimeText}}</text>
          <view class="order-total">
            <text class="total-label">共 {{item.totalQty || 1}} 件，实付款</text>
            <view class="total-price">
              <text class="total-symbol">¥</text>
              <text class="total-value">{{item.totalAmount}}</text>
            </view>
          </view>
        </view>

        <!-- Action Buttons -->
        <view class="action-buttons" catchtap="stopPropagation">
          <!-- 待付款：取消订单 + 去支付 -->
          <view
            class="action-btn btn-cancel"
            wx:if="{{item.status === 0}}"
            bindtap="cancelOrder"
            data-id="{{item.id}}"
          >
            <text>取消订单</text>
          </view>
          <view
            class="action-btn btn-primary"
            wx:if="{{item.status === 0}}"
            bindtap="payOrder"
            data-id="{{item.id}}"
          >
            <text>去支付</text>
          </view>
          <!-- 待发货：申请取消（需商家审核） -->
          <view
            class="action-btn btn-cancel"
            wx:if="{{item.status === 1}}"
            bindtap="applyCancel"
            data-id="{{item.id}}"
          >
            <text>申请取消</text>
          </view>
          <!-- 待收货：确认收货 -->
          <view
            class="action-btn btn-confirm"
            wx:if="{{item.status === 2}}"
            bindtap="confirmReceipt"
            data-id="{{item.id}}"
          >
            <text>确认收货</text>
          </view>
          <!-- 已完成：申请退款 -->
          <view
            class="action-btn btn-cancel"
            wx:if="{{item.status === 3}}"
            bindtap="applyRefund"
            data-id="{{item.id}}"
          >
            <text>申请退款</text>
          </view>
          <view
            class="action-btn btn-detail"
            bindtap="viewDetail"
            data-id="{{item.id}}"
          >
            <text>查看详情</text>
          </view>
        </view>
      </view>

      <!-- Empty State -->
      <view class="empty-state" wx:if="{{orders.length === 0 && !loading}}">
        <view class="empty-icon-box">
          <text class="material-symbols-outlined empty-icon">inbox</text>
        </view>
        <text class="empty-title">暂无订单</text>
        <text class="empty-desc">快去选购心仪的萌宠用品吧~</text>
        <view class="empty-btn" bindtap="goShopping">
          <text>去逛逛</text>
        </view>
      </view>

      <!-- Loading / No More -->
      <view class="loading-state" wx:if="{{loading}}">
        <text class="loading-text">加载中...</text>
      </view>
      <view class="no-more-state" wx:if="{{noMore && orders.length > 0}}">
        <view class="paw-line">
          <text class="material-symbols-outlined paw-icon">pets</text>
        </view>
        <text class="no-more-text">— 已加载全部订单 —</text>
      </view>
    </view>
  </scroll-view>

  <!-- Decorative Blurs -->
  <view class="blur-top-right"></view>
  <view class="blur-bottom-left"></view>
</view>
