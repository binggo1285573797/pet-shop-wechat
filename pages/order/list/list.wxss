/* pages/order/list/list.wxss - 基于Stitch设计 */
.order-list-page {
  width: 100vw;
  min-height: 100vh;
  background: #fdfbf9;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* TopAppBar */
.app-header {
  position: fixed;
  top: 0;
  width: 100%;
  height: 96rpx;
  background: #ffffff;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  padding-top: env(safe-area-inset-top);
  border-bottom: 1rpx solid rgba(255, 138, 101, 0.1);
}

.header-row {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.back-icon {
  font-size: 44rpx;
  color: #ff8a65;
}

.header-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1c1c;
  font-family: "Plus Jakarta Sans", sans-serif;
  text-align: center;
}

.header-spacer {
  width: 80rpx;
}

/* Status Tabs */
.status-tabs {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  height: 88rpx;
  background: #ffffff;
  z-index: 99;
  border-bottom: 1rpx solid rgba(255, 138, 101, 0.1);
}

.tabs-scroll {
  height: 100%;
  white-space: nowrap;
}

.tabs-container {
  display: flex;
  align-items: center;
  height: 100%;
  padding: 0 24rpx;
}

.tab-item {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
  height: 100%;
}

.tab-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #89726b;
  transition: all 0.3s ease;
}

.tab-item.active .tab-label {
  font-size: 32rpx;
  font-weight: 700;
  color: #ff8a65;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  width: 48rpx;
  height: 6rpx;
  background: linear-gradient(135deg, #ff8a65 0%, #ffab91 100%);
  border-radius: 3rpx;
}

/* Order Scroll */
.order-scroll {
  flex: 1;
  margin-top: 88rpx;
  height: calc(100vh - 88rpx);
}

.order-list-container {
  padding: 24rpx 32rpx 120rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  max-width: 750rpx;
  margin: 0 auto;
}

/* Order Card */
.order-card {
  background: #ffffff;
  border-radius: 48rpx;
  padding: 48rpx;
  box-shadow: 0 24rpx 80rpx rgba(255, 138, 101, 0.06);
  border: 1rpx solid rgba(255, 138, 101, 0.05);
}

/* Shop Row */
.shop-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.shop-icon-box {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: rgba(255, 138, 101, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.shop-icon {
  font-size: 32rpx;
  color: #ff8a65;
}

.shop-name {
  flex: 1;
  font-size: 28rpx;
  font-weight: 800;
  color: #1a1c1c;
  font-family: "Plus Jakarta Sans", sans-serif;
  letter-spacing: 1rpx;
  text-transform: uppercase;
}

.order-status-badge {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.order-status-badge.status-0 {
  background: rgba(255, 138, 101, 0.15);
  color: #ff8a65;
}

.order-status-badge.status-1 {
  background: rgba(76, 175, 80, 0.15);
  color: #4caf50;
}

.order-status-badge.status-2 {
  background: rgba(33, 150, 243, 0.15);
  color: #2196f3;
}

.order-status-badge.status-3 {
  background: rgba(156, 39, 176, 0.15);
  color: #9c27b0;
}

.order-status-badge.status-4 {
  background: rgba(137, 114, 107, 0.15);
  color: #89726b;
}

/* Product List */
.product-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.product-item {
  display: flex;
  gap: 24rpx;
}

.product-img-box {
  width: 160rpx;
  height: 160rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #f3f3f3;
  flex-shrink: 0;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.06);
}

.product-img {
  width: 100%;
  height: 100%;
}

.product-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.product-placeholder .material-symbols-outlined {
  font-size: 56rpx;
  color: rgba(0,0,0,0.1);
}

.product-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 8rpx 0;
}

.product-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1a1c1c;
  line-height: 1.4;
  font-family: "Plus Jakarta Sans", sans-serif;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.product-price-row {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.price-symbol {
  font-size: 22rpx;
  font-weight: 700;
  color: #89726b;
}

.price-value {
  font-size: 36rpx;
  font-weight: 900;
  color: #1a1c1c;
  font-family: "Plus Jakarta Sans", sans-serif;
}

.product-qty {
  margin-left: auto;
  font-size: 26rpx;
  font-weight: 600;
  color: #89726b;
}

/* Order Summary */
.order-summary {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 2rpx dashed rgba(137, 114, 107, 0.2);
}

.order-time {
  font-size: 24rpx;
  color: #89726b;
}

.order-total {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.total-label {
  font-size: 24rpx;
  color: #89726b;
}

.total-price {
  display: flex;
  align-items: baseline;
  gap: 2rpx;
}

.total-symbol {
  font-size: 24rpx;
  font-weight: 800;
  color: #ff8a65;
}

.total-value {
  font-size: 48rpx;
  font-weight: 900;
  color: #ff8a65;
  font-family: "Plus Jakarta Sans", sans-serif;
  letter-spacing: -2rpx;
}

/* Action Buttons */
.action-buttons {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 32rpx;
}

.action-btn {
  padding: 16rpx 32rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 700;
  font-family: "Plus Jakarta Sans", sans-serif;
  transition: all 0.3s ease;
}

.action-btn:active {
  transform: scale(0.95);
}

.btn-cancel {
  background: rgba(137, 114, 107, 0.1);
  color: #89726b;
  border: 2rpx solid rgba(137, 114, 107, 0.2);
}

.btn-primary {
  background: linear-gradient(135deg, #ff8a65 0%, #ffab91 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(255, 138, 101, 0.3);
}

.btn-confirm {
  background: linear-gradient(135deg, #4caf50 0%, #81c784 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(76, 175, 80, 0.3);
}

.btn-detail {
  background: rgba(255, 138, 101, 0.1);
  color: #ff8a65;
  border: 2rpx solid rgba(255, 138, 101, 0.3);
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon-box {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 138, 101, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  color: rgba(255, 138, 101, 0.5);
}

.empty-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #56423c;
  font-family: "Plus Jakarta Sans", sans-serif;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #89726b;
  margin-bottom: 48rpx;
}

.empty-btn {
  background: linear-gradient(135deg, #ff8a65 0%, #ffab91 100%);
  color: #ffffff;
  padding: 24rpx 64rpx;
  border-radius: 64rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 48rpx rgba(255, 138, 101, 0.4);
  font-family: "Plus Jakarta Sans", sans-serif;
}

/* Loading State */
.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #89726b;
}

/* No More State */
.no-more-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
}

.paw-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  opacity: 0.3;
}

.paw-icon {
  font-size: 32rpx;
  color: #ff8a65;
}

.no-more-text {
  font-size: 24rpx;
  color: #89726b;
}

/* Decorative Blurs */
.blur-top-right {
  position: fixed;
  top: 20%;
  right: -160rpx;
  width: 320rpx;
  height: 320rpx;
  background: rgba(255, 138, 101, 0.05);
  border-radius: 50%;
  filter: blur(80rpx);
  z-index: -1;
}

.blur-bottom-left {
  position: fixed;
  bottom: 15%;
  left: -200rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255, 138, 101, 0.08);
  border-radius: 50%;
  filter: blur(100rpx);
  z-index: -1;
}
