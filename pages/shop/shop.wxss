/* pages/shop/shop.wxss */
.shop-page {
  width: 100vw;
  min-height: 100vh;
  background: #f9f9f9;
}

/* 顶部固定区域毛玻璃效果 */
.shop-header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(24rpx);
  box-shadow: 0 12rpx 32rpx rgba(159, 65, 34, 0.06);
  padding: calc(env(safe-area-inset-top) + 80rpx) 0 24rpx;
}

/* 搜索栏区 */
.search-box {
  padding: 24rpx 32rpx;
}

.search-inner {
  background: rgba(245, 245, 244, 0.6);
  border-radius: 64rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  height: 88rpx;
  border: 1rpx solid #f5f5f4;
  box-shadow: inset 0 4rpx 8rpx rgba(0, 0, 0, 0.03);
}

.search-icon {
  font-size: 40rpx;
  color: #89726b;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #1a1c1c;
  height: 100%;
}

.search-ph {
  color: rgba(137, 114, 107, 0.6);
}

/* 分类 Tabs */
.cat-nav-wrap {
  padding: 0 0 16rpx;
  width: 100%;
  overflow: hidden;
}

.cat-scroll {
  white-space: nowrap;
  width: 100%;
}

.cat-list {
  display: inline-flex;
  padding: 0 32rpx;
  gap: 20rpx;
}

.cat-item {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 32rpx;
  border-radius: 64rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(86, 66, 60, 0.7);
  background: #ffffff;
  border: 2rpx solid #f5f5f4;
  white-space: nowrap;
  transition: all 0.2s;
}

.cat-item.active {
  background: #FF8A65;
  color: #fff;
  border-color: #FF8A65;
  box-shadow: 0 8rpx 20rpx rgba(255, 138, 101, 0.2);
}

.cat-icon {
  font-size: 32rpx;
}

.cat-empty {
  padding: 16rpx 32rpx;
  color: rgba(86, 66, 60, 0.5);
}

.cat-empty-text {
  font-size: 24rpx;
}

/* 商品网格 */
.product-area {
  padding: 32rpx 32rpx 200rpx;
}

.shop-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.product-card {
  background: #ffffff;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
  transition: all 0.3s;
}

.product-card:active {
  transform: scale(0.98);
}

.card-img-wrap {
  width: 100%;
  aspect-ratio: 1;
  position: relative;
  overflow: hidden;
  background: #f3f3f3;
}

.card-img {
  width: 100%;
  height: 100%;
}

.card-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f3f3;
}

.card-placeholder .material-symbols-outlined {
  font-size: 64rpx;
  color: rgba(0, 0, 0, 0.1);
}

.card-badge {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  background: rgba(0, 0, 0, 0.3);
  backdrop-filter: blur(8rpx);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  padding: 8rpx 16rpx;
  border-radius: 32rpx;
  letter-spacing: 1rpx;
}

.card-body {
  padding: 24rpx;
}

.product-title {
  font-size: 26rpx;
  font-weight: 700;
  color: #1a1c1c;
  line-height: 1.4;
  margin-bottom: 12rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  min-height: 72rpx;
}

.merchant-tag {
  font-size: 20rpx;
  color: rgba(86, 66, 60, 0.6);
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

.merchant-tag .material-symbols-outlined {
  font-size: 20rpx;
}

.price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.price-val {
  font-size: 32rpx;
  font-family: "Plus Jakarta Sans", sans-serif;
  font-weight: 800;
  color: #FF8A65;
}

/* 渐变购物车按钮 */
.buy-circle {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF8A65 0%, #FF7043 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(255, 138, 101, 0.35);
}

.buy-circle .material-symbols-outlined {
  font-size: 28rpx;
}

/* 状态提示 */
.status-msg {
  text-align: center;
  padding: 48rpx;
  font-size: 24rpx;
  color: rgba(86, 66, 60, 0.5);
}

.empty-view {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: #ccc;
  gap: 16rpx;
}

.empty-view .material-symbols-outlined {
  font-size: 96rpx;
}

.list-end-spacer {
  height: 40rpx;
}
