/* pages/index/index.wxss */
.index-page {
  width: 100vw;
  height: 100vh;
  background: #f9f9f9;
  display: flex;
  flex-direction: column;
}

/* Main Container */
.scroll-body {
  flex: 1;
}

.main-container {
  padding: 140rpx 32rpx 200rpx; /* Top padding matches header height */
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

/* Hero Carousel */
.hero-section {
  position: relative;
  width: 100%;
  height: 380rpx;
  border-radius: 40rpx;
  overflow: hidden;
  background: #eeeeee;
}

.hero-swiper, .hero-slide, .hero-image {
  width: 100%;
  height: 100%;
}

.hero-placeholder {
  width: 100%;
  height: 100%;
}
.banner-warm { background: linear-gradient(135deg, #FFdbd0, #FF8A65); }
.banner-cool { background: linear-gradient(135deg, #e3f2fd, #90caf9); }
.banner-green { background: linear-gradient(135deg, #e8f5e9, #81c784); }

.hero-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 40rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.4), transparent);
  display: flex;
  flex-direction: column;
}

.hero-title {
  color: #fff;
  font-size: 36rpx;
  font-weight: 800;
  margin-bottom: 8rpx;
  text-shadow: 0 4rpx 8rpx rgba(0,0,0,0.2);
}

.hero-subtitle {
  color: rgba(255,255,255,0.8);
  font-size: 24rpx;
}

.hero-indicators {
  position: absolute;
  bottom: 30rpx;
  right: 40rpx;
  display: flex;
  gap: 12rpx;
}

.indicator {
  font-size: 20rpx;
  color: rgba(255,255,255,0.5);
}

.indicator.active {
  color: #FF8A65;
}

/* Stats Bento */
.stats-bento {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.stat-card {
  background: #ffffff;
  border-radius: 40rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 138, 101, 0.08);
  border: 1rpx solid #eeeeee;
}

.stat-inner {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.stat-label-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.stat-icon-bg {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: rgba(255, 138, 101, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.stat-icon {
  font-size: 32rpx;
  color: #FF8A65;
}

.stat-label {
  font-size: 24rpx;
  font-weight: 800;
  color: #FF8A65;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 900;
  color: #FF8A65;
  letter-spacing: -1rpx;
}

/* Section Title */
.section-area {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.section-title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.h3 {
  font-size: 36rpx;
  font-weight: 800;
  color: #1a1c1c;
}

.view-more {
  font-size: 24rpx;
  font-weight: 700;
  color: #FF8A65;
}

/* Waterfall Grid (Masonry using Columns) */
.waterfall-grid {
  column-count: 2;
  column-gap: 24rpx;
}

.waterfall-item {
  break-inside: avoid;
  background: #ffffff;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.04);
  margin-bottom: 24rpx;
}

.wf-img-box {
  width: 100%;
}

.wf-img {
  width: 100%;
  display: block;
}

.wf-placeholder {
  width: 100%;
  aspect-ratio: 1;
  background: #f3f3f3;
  display: flex;
  align-items: center;
  justify-content: center;
}

.wf-placeholder .material-symbols-outlined {
  font-size: 48rpx;
  color: rgba(0,0,0,0.1);
}

.wf-info {
  padding: 24rpx;
}

.wf-name {
  font-size: 26rpx;
  font-weight: 700;
  color: #1a1c1c;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 16rpx;
}

.wf-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.wf-price {
  font-size: 32rpx;
  font-weight: 800;
  color: #FF8A65;
}

.wf-cart-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 138, 101, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
}

.wf-cart-btn .material-symbols-outlined {
  font-size: 28rpx;
  color: #FF8A65;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
  color: #ccc;
  gap: 16rpx;
}

.empty-state .material-symbols-outlined {
  font-size: 80rpx;
}

.bottom-spacer {
  height: 100rpx;
}
