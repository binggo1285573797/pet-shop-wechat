/* pages/community/detail/detail.wxss - Stitch 风格帖子详情页面 */

.detail-page {
  min-height: 100vh;
  background: #f9f9f9;
  position: relative;
}

/* 自定义导航栏 */
.custom-nav {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(249, 249, 249, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  padding-top: var(--status-bar-height, 44rpx);
}

.nav-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 24rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(255, 138, 101, 0.1);
  transition: all 0.2s ease;
}

.back-btn:active {
  background: rgba(255, 138, 101, 0.2);
  transform: scale(0.95);
}

.back-icon {
  font-size: 32rpx;
  color: #FF8A65;
}

.nav-title {
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1c1c;
}

.nav-actions {
  display: flex;
  align-items: center;
  gap: 8rpx;
  width: 72rpx;
  justify-content: flex-end;
}

.more-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.2s ease;
}

.more-btn:active {
  background: rgba(0, 0, 0, 0.05);
  transform: scale(0.95);
}

.more-icon {
  font-size: 40rpx;
  color: #333333;
}

/* 编辑按钮 */
.edit-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 138, 101, 0.1);
  transition: all 0.2s ease;
}

.edit-btn:active {
  background: rgba(255, 138, 101, 0.2);
  transform: scale(0.95);
}

.edit-icon {
  font-size: 32rpx;
  color: #FF8A65;
}

.action-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: all 0.2s ease;
}

.action-btn:active {
  background: rgba(0, 0, 0, 0.05);
  transform: scale(0.95);
}

.action-btn .material-symbols-outlined {
  font-size: 40rpx;
  color: #333333;
}

/* 主内容区 */
.detail-content {
  padding-bottom: 160rpx;
  padding-top: 48rpx;
}

/* 图片轮播 */
.image-carousel {
  padding: 24rpx 32rpx;
}

.carousel-swiper {
  height: 800rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

.carousel-image {
  width: 100%;
  height: 100%;
}

/* 内容卡片 */
.content-card {
  margin: -60rpx 32rpx 32rpx;
  padding: 48rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 32rpx rgba(159, 65, 34, 0.06);
  position: relative;
  z-index: 10;
}

.post-title {
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1c1c;
  line-height: 1.4;
  margin-bottom: 48rpx;
}

/* 作者信息 */
.author-section {
  display: flex;
  align-items: center;
  margin-bottom: 56rpx;
}

.author-info {
  display: flex;
  align-items: center;
}

.author-avatar-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
}

.author-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  object-fit: cover;
  border: 4rpx solid #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.author-avatar-default {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF8A65 0%, #FF7043 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #ffffff;
  border: 4rpx solid #ffffff;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}

.author-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 32rpx;
  height: 32rpx;
  background: #9f4122;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #ffffff;
}

.badge-icon {
  font-size: 20rpx;
  color: #ffffff;
  font-variation-settings: 'FILL' 1;
}

.author-name {
  margin-left: 24rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1c1c;
}

.follow-btn {
  background: #f5f5f5;
  color: #9f4122;
  font-size: 28rpx;
  font-weight: 700;
  padding: 16rpx 40rpx;
  border-radius: 48rpx;
  border: 2rpx solid rgba(137, 114, 107, 0.1);
  transition: all 0.2s ease;
}

.follow-btn:active {
  background: #eeeeee;
  transform: scale(0.98);
}

/* 正文内容 */
.post-body {
  margin-bottom: 48rpx;
}

.post-text {
  font-size: 32rpx;
  color: #56423c;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* 话题标签 */
.topic-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 32rpx;
}

.topic-tag {
  background: #eeeeee;
  padding: 12rpx 28rpx;
  border-radius: 32rpx;
}

.topic-tag text {
  font-size: 24rpx;
  color: #845142;
  font-weight: 500;
}

/* 发布时间和浏览量 */
.post-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.meta-text {
  font-size: 24rpx;
  color: #89726b;
}

.meta-dot {
  font-size: 24rpx;
  color: #89726b;
}

/* 评论区 */
.comment-section {
  margin: 32rpx;
  padding: 40rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.comment-header {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.comment-title {
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1c1c;
}

.comment-count {
  font-size: 28rpx;
  color: #89726b;
  margin-left: 12rpx;
}

/* 评论列表 */
.comment-list {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.comment-item {
  display: flex;
  gap: 24rpx;
}

.comment-avatar-wrap {
  flex-shrink: 0;
}

.comment-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  object-fit: cover;
}

.comment-avatar-default {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #FF8A65 0%, #FF7043 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
}

.comment-body {
  flex: 1;
}

.comment-author-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.comment-author-name {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1c1c;
}

.comment-like {
  padding: 8rpx;
}

.like-icon {
  font-size: 36rpx;
  color: #d4d4d4;
  transition: all 0.2s ease;
}

.like-icon.active {
  color: #FF8A65;
  font-variation-settings: 'FILL' 1;
}

.comment-text {
  font-size: 28rpx;
  color: #56423c;
  line-height: 1.6;
  margin-bottom: 16rpx;
}

.comment-footer {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.comment-time {
  font-size: 22rpx;
  color: #a0a0a0;
}

.comment-reply {
  font-size: 22rpx;
  color: #89726b;
  font-weight: 500;
}

/* 空评论状态 */
.empty-comment {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  color: #d4d4d4;
  margin-bottom: 24rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #89726b;
}

/* 底部互动栏 */
.interaction-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 24rpx;
  border-top: 2rpx solid rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.comment-input-wrapper {
  flex: 1;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
}

.input-placeholder {
  font-size: 28rpx;
  color: #a0a0a0;
}

.interaction-actions {
  display: flex;
  align-items: center;
  gap: 40rpx;
}

.action-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 4rpx;
}

.action-icon {
  font-size: 48rpx;
  color: #333333;
  transition: all 0.2s ease;
}

.action-icon.active {
  color: #FF8A65;
  font-variation-settings: 'FILL' 1;
}

.action-count {
  font-size: 22rpx;
  font-weight: 700;
  color: #333333;
}

.action-count.active {
  color: #FF8A65;
}

/* 评论输入弹窗 */
.comment-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-radius: 32rpx 32rpx 0 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.modal-cancel {
  font-size: 28rpx;
  color: #89726b;
  padding: 16rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1c1c;
}

.modal-submit {
  font-size: 28rpx;
  color: #d4d4d4;
  font-weight: 700;
  padding: 16rpx;
}

.modal-submit.active {
  color: #9f4122;
}

.modal-textarea {
  width: 100%;
  height: 240rpx;
  font-size: 32rpx;
  color: #1a1c1c;
  line-height: 1.6;
}
