/* pages/community/detail/detail.wxss - 基于Stitch设计 */
.detail-page {
  width: 100vw;
  min-height: 100vh;
  background: #fdfbf9;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* TopAppBar */
.app-header {
  position: fixed;
  top: 0;
  width: 100%;
  height: 96rpx;
  background: #ffffff;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  padding-top: env(safe-area-inset-top);
  border-bottom: 1rpx solid rgba(255, 138, 101, 0.1);
}

.header-row {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.back-icon {
  font-size: 44rpx;
  color: #ff8a65;
}

.header-title {
  flex: 1;
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1c1c;
  font-family: "Plus Jakarta Sans", sans-serif;
  text-align: center;
}

.header-spacer {
  width: 80rpx;
}

.more-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.more-icon {
  font-size: 44rpx;
  color: #89726b;
}

/* Detail Scroll */
.detail-scroll {
  flex: 1;
  margin-top: 96rpx;
  height: calc(100vh - 96rpx);
}

.detail-container {
  padding: 48rpx 32rpx 200rpx;
  max-width: 750rpx;
  margin: 0 auto;
}

/* Author Card */
.author-card {
  background: #ffffff;
  border-radius: 48rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 24rpx 80rpx rgba(255, 138, 101, 0.06);
  border: 1rpx solid rgba(255, 138, 101, 0.05);
}

.author-main {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.author-avatar-box {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f3f3f3;
  flex-shrink: 0;
}

.author-avatar-img {
  width: 100%;
  height: 100%;
}

.author-avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ff8a65 0%, #ffab91 100%);
}

.placeholder-icon {
  font-size: 48rpx;
  color: rgba(255,255,255,0.8);
}

.author-info {
  flex: 1;
}

.author-name-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.author-name {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a1c1c;
  font-family: "Plus Jakarta Sans", sans-serif;
}

.follow-btn {
  background: linear-gradient(135deg, #ff8a65 0%, #ffab91 100%);
  color: #ffffff;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.post-time {
  font-size: 24rpx;
  color: #89726b;
}

/* Content Card */
.content-card {
  background: #ffffff;
  border-radius: 48rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 24rpx 80rpx rgba(255, 138, 101, 0.06);
  border: 1rpx solid rgba(255, 138, 101, 0.05);
}

.post-text {
  font-size: 30rpx;
  font-weight: 500;
  color: #1a1c1c;
  line-height: 1.8;
  white-space: pre-wrap;
}

/* Post Images */
.post-images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 32rpx;
}

.post-img-item {
  width: calc(33.33% - 12rpx);
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f3f3f3;
}

.post-img-item.single {
  width: 100%;
  max-width: 500rpx;
  aspect-ratio: 4/3;
}

.post-img {
  width: 100%;
  height: 100%;
}

/* Post Tags */
.post-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.post-tag {
  font-size: 26rpx;
  color: #ff8a65;
  font-weight: 500;
}

/* Post Stats */
.post-stats {
  display: flex;
  align-items: center;
  gap: 48rpx;
  margin-top: 32rpx;
  padding-top: 32rpx;
  border-top: 2rpx dashed rgba(137, 114, 107, 0.2);
}

.stat-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stat-icon {
  font-size: 32rpx;
  color: #89726b;
}

.stat-icon.icon-fill {
  color: #ff8a65;
}

.stat-value {
  font-size: 26rpx;
  font-weight: 600;
  color: #89726b;
}

/* Comments Section */
.comments-section {
  background: #ffffff;
  border-radius: 48rpx;
  padding: 40rpx;
  box-shadow: 0 24rpx 80rpx rgba(255, 138, 101, 0.06);
  border: 1rpx solid rgba(255, 138, 101, 0.05);
}

.comments-header {
  margin-bottom: 32rpx;
}

.comments-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #1a1c1c;
  font-family: "Plus Jakarta Sans", sans-serif;
}

/* Comment List */
.comment-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.comment-item {
  display: flex;
  gap: 20rpx;
}

.comment-avatar-box {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #f3f3f3;
  flex-shrink: 0;
}

.comment-avatar-img {
  width: 100%;
  height: 100%;
}

.comment-avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #ff8a65 0%, #ffab91 100%);
}

.comment-body {
  flex: 1;
}

.comment-header-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.comment-author {
  font-size: 28rpx;
  font-weight: 700;
  color: #1a1c1c;
  font-family: "Plus Jakarta Sans", sans-serif;
}

.comment-time {
  font-size: 22rpx;
  color: #89726b;
}

.comment-text {
  font-size: 28rpx;
  color: #56423c;
  line-height: 1.6;
  display: block;
}

.comment-actions {
  display: flex;
  align-items: center;
  gap: 32rpx;
  margin-top: 16rpx;
}

.comment-action {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.action-icon {
  font-size: 28rpx;
  color: #89726b;
}

.action-icon.icon-fill {
  color: #ff8a65;
}

.action-count {
  font-size: 24rpx;
  color: #89726b;
}

/* Empty Comments */
.empty-comments {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.empty-icon {
  font-size: 64rpx;
  color: rgba(255, 138, 101, 0.3);
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #89726b;
}

.bottom-spacer {
  height: 40rpx;
}

/* Comment Bar */
.comment-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(40rpx);
  border-radius: 48rpx 48rpx 0 0;
  z-index: 200;
  box-shadow: 0 -8rpx 32rpx rgba(255, 138, 101, 0.1);
  border-top: 1rpx solid rgba(255, 138, 101, 0.05);
}

.comment-input-wrap {
  flex: 1;
}

.comment-input {
  width: 100%;
  background: #f3f3f3;
  border-radius: 40rpx;
  padding: 20rpx 28rpx;
  font-size: 28rpx;
  color: #1a1c1c;
}

.comment-input::placeholder {
  color: rgba(137, 114, 107, 0.5);
}

.comment-actions-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.action-btn {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(137, 114, 107, 0.1);
  transition: all 0.3s ease;
}

.action-btn:active {
  transform: scale(0.9);
}

.action-btn.liked {
  background: rgba(255, 138, 101, 0.15);
}

.send-btn {
  background: linear-gradient(135deg, #ff8a65 0%, #ffab91 100%);
  color: #ffffff;
  padding: 20rpx 32rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 700;
  font-family: "Plus Jakarta Sans", sans-serif;
}

/* Decorative Blurs */
.blur-top-left {
  position: fixed;
  top: 25%;
  left: -160rpx;
  width: 320rpx;
  height: 320rpx;
  background: rgba(255, 138, 101, 0.05);
  border-radius: 50%;
  filter: blur(80rpx);
  z-index: -1;
}

.blur-bottom-right {
  position: fixed;
  bottom: 15%;
  right: -200rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255, 138, 101, 0.08);
  border-radius: 50%;
  filter: blur(100rpx);
  z-index: -1;
}
