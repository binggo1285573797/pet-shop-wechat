/* pages/community/community.wxss - 基于Stitch设计 */
.community-page {
  width: 100vw;
  min-height: 100vh;
  background: #fdfbf9;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* TopAppBar */
.app-header {
  position: fixed;
  top: 0;
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #ff8a65 0%, #ffab91 100%);
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  padding-top: env(safe-area-inset-top);
}

.header-row {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-box {
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
}

.logo-icon {
  font-size: 32rpx;
  color: #ffffff;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #ffffff;
  font-family: "Plus Jakarta Sans", sans-serif;
  margin-left: 16rpx;
}

.header-spacer {
  width: 80rpx;
}

/* Category Tabs */
.category-tabs {
  position: fixed;
  top: 96rpx;
  left: 0;
  right: 0;
  height: 88rpx;
  background: #ffffff;
  z-index: 99;
  border-bottom: 1rpx solid rgba(255, 138, 101, 0.1);
  box-shadow: 0 4rpx 12rpx rgba(255, 138, 101, 0.05);
}

.tabs-scroll {
  height: 100%;
  white-space: nowrap;
}

.tabs-container {
  display: flex;
  align-items: center;
  height: 100%;
  padding: 0 16rpx;
}

.tab-item {
  position: relative;
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 0 24rpx;
  height: 100%;
  transition: all 0.3s ease;
}

.tab-icon {
  font-size: 32rpx;
}

.tab-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #89726b;
  transition: all 0.3s ease;
}

.tab-item.active .tab-label {
  font-size: 30rpx;
  font-weight: 700;
  color: #ff8a65;
}

.tab-indicator {
  position: absolute;
  bottom: 0;
  width: 40rpx;
  height: 6rpx;
  background: linear-gradient(135deg, #ff8a65 0%, #ffab91 100%);
  border-radius: 3rpx;
}

/* Posts Scroll */
.posts-scroll {
  flex: 1;
  margin-top: 184rpx;
  height: calc(100vh - 184rpx);
}

.posts-container {
  padding: 48rpx 32rpx 120rpx;
  max-width: 750rpx;
  margin: 0 auto;
}

/* Waterfall Grid */
.waterfall-grid {
  column-count: 2;
  column-gap: 24rpx;
}

.post-card {
  break-inside: avoid;
  margin-bottom: 24rpx;
  background: #ffffff;
  border-radius: 40rpx;
  overflow: hidden;
  box-shadow: 0 24rpx 80rpx rgba(255, 138, 101, 0.06);
  border: 1rpx solid rgba(255, 138, 101, 0.05);
  transition: all 0.3s ease;
}

.post-card:active {
  transform: scale(0.98);
}

/* Post Image */
.post-img-box {
  position: relative;
  width: 100%;
  background: #f3f3f3;
}

.post-img {
  width: 100%;
  display: block;
}

.post-img-placeholder {
  width: 100%;
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #f3f3f3;
}

.placeholder-icon {
  font-size: 64rpx;
  color: rgba(0,0,0,0.1);
}

.post-img-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 16rpx;
  background: linear-gradient(to top, rgba(0,0,0,0.4), transparent);
}

.like-badge {
  display: flex;
  align-items: center;
  gap: 8rpx;
  align-self: flex-end;
  padding: 8rpx 16rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 20rpx;
}

.like-icon {
  font-size: 28rpx;
  color: #89726b;
}

.like-count {
  font-size: 24rpx;
  font-weight: 600;
  color: #89726b;
}

.like-badge.liked .like-icon,
.like-badge.liked .like-count {
  color: #ff8a65;
}

/* Post Content */
.post-content {
  padding: 24rpx;
}

.post-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1c1c;
  line-height: 1.5;
  margin-bottom: 20rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.post-author {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.author-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff8a65 0%, #ffab91 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid rgba(255, 138, 101, 0.2);
}

.author-avatar-text {
  font-size: 20rpx;
  font-weight: 800;
  color: #ffffff;
}

.author-name {
  font-size: 22rpx;
  font-weight: 500;
  color: #89726b;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 0;
}

.empty-icon-box {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(255, 138, 101, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  color: rgba(255, 138, 101, 0.5);
}

.empty-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #56423c;
  font-family: "Plus Jakarta Sans", sans-serif;
  margin-bottom: 16rpx;
}

.empty-desc {
  font-size: 28rpx;
  color: #89726b;
  margin-bottom: 48rpx;
}

.empty-btn {
  background: linear-gradient(135deg, #ff8a65 0%, #ffab91 100%);
  color: #ffffff;
  padding: 24rpx 64rpx;
  border-radius: 64rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 16rpx 48rpx rgba(255, 138, 101, 0.4);
  font-family: "Plus Jakarta Sans", sans-serif;
}

/* Loading State */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.loading-paw {
  animation: paw-bounce 1s ease-in-out infinite;
}

.paw-icon {
  font-size: 48rpx;
  color: rgba(255, 138, 101, 0.5);
}

.loading-text {
  font-size: 26rpx;
  color: #89726b;
  margin-top: 16rpx;
}

@keyframes paw-bounce {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10rpx); }
}

/* No More State */
.no-more-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0;
}

.paw-divider {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
  opacity: 0.3;
}

.divider-icon {
  font-size: 32rpx;
  color: #ff8a65;
}

.no-more-text {
  font-size: 24rpx;
  color: #89726b;
}

/* FAB Post Button */
.fab-container {
  position: fixed;
  bottom: 200rpx;
  right: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  z-index: 100;
}

.fab-btn {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff8a65 0%, #ffab91 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 48rpx rgba(255, 138, 101, 0.4);
  transition: all 0.3s ease;
}

.fab-btn:active {
  transform: scale(0.9);
}

.fab-icon {
  font-size: 48rpx;
  color: #ffffff;
}

.fab-label {
  font-size: 20rpx;
  font-weight: 700;
  color: #ff8a65;
  font-family: "Plus Jakarta Sans", sans-serif;
}

/* Decorative Blurs */
.blur-top-right {
  position: fixed;
  top: 15%;
  right: -160rpx;
  width: 320rpx;
  height: 320rpx;
  background: rgba(255, 138, 101, 0.05);
  border-radius: 50%;
  filter: blur(80rpx);
  z-index: -1;
}

.blur-bottom-left {
  position: fixed;
  bottom: 20%;
  left: -200rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255, 138, 101, 0.08);
  border-radius: 50%;
  filter: blur(100rpx);
  z-index: -1;
}
