<!--pages/community/community.wxml - Stitch 风格社区页面-->
<view class="community-page">
  <!-- 顶部导航栏 -->
  <view class="community-header">
    <view class="header-content">
      <text class="material-symbols-outlined header-icon">pets</text>
      <text class="header-title">爱宠家</text>
    </view>
  </view>

  <!-- 主内容区 -->
  <view class="community-content">
    <!-- 加载状态 -->
    <view wx:if="{{loading && posts.length === 0}}" class="loading-container">
      <view class="paw-loader">
        <text class="material-symbols-outlined paw-icon">pets</text>
        <text class="material-symbols-outlined paw-icon">pets</text>
        <text class="material-symbols-outlined paw-icon">pets</text>
      </view>
      <text class="loading-text">正在加载萌宠动态...</text>
    </view>

    <!-- 空状态 -->
    <view wx:elif="{{posts.length === 0}}" class="empty-state">
      <text class="material-symbols-outlined empty-icon">forum</text>
      <text class="empty-text">还没有帖子哦</text>
      <text class="empty-subtext">快来分享你和宠物的故事吧~</text>
    </view>

    <!-- 瀑布流帖子列表 -->
    <view wx:else class="waterfall-container">
      <!-- 左列 -->
      <view class="waterfall-column">
        <block wx:for="{{posts}}" wx:key="id" wx:if="{{index % 2 === 0}}">
          <view class="post-card" bindtap="goToDetail" data-id="{{item.id}}">
            <!-- 有图片时显示图片 -->
            <image wx:if="{{item.picList && item.picList.length > 0}}" class="post-image" src="{{item.picList[0]}}" mode="widthFix" lazy-load/>
            <!-- 无图片时显示文字背景卡片 -->
            <view wx:else class="post-text-card {{item.bgClass || 'bg-gradient-1'}}">
              <text class="post-text-content">{{item.title || item.content}}</text>
              <view class="post-text-mask"></view>
            </view>
            <view class="post-content">
              <text wx:if="{{item.picList && item.picList.length > 0}}" class="post-title">{{item.title || item.content}}</text>
              <view class="post-footer">
                <view class="post-author">
                  <image wx:if="{{item.authorAvatar}}" class="author-avatar" src="{{item.authorAvatar}}"/>
                  <view wx:else class="author-avatar-text">{{item.authorName ? item.authorName[0] : 'U'}}</view>
                  <text class="author-name">{{item.authorName || '匿名用户'}}</text>
                </view>
                <view class="post-likes">
                  <text class="material-symbols-outlined like-icon {{item.isLiked ? 'active' : ''}}">pets</text>
                  <text class="like-count {{item.isLiked ? 'active' : ''}}">{{item.likeCount || 0}}</text>
                </view>
              </view>
            </view>
          </view>
        </block>
      </view>

      <!-- 右列 -->
      <view class="waterfall-column">
        <block wx:for="{{posts}}" wx:key="id" wx:if="{{index % 2 === 1}}">
          <view class="post-card" bindtap="goToDetail" data-id="{{item.id}}">
            <!-- 有图片时显示图片 -->
            <image wx:if="{{item.picList && item.picList.length > 0}}" class="post-image" src="{{item.picList[0]}}" mode="widthFix" lazy-load/>
            <!-- 无图片时显示文字背景卡片 -->
            <view wx:else class="post-text-card {{item.bgClass || 'bg-gradient-1'}}">
              <text class="post-text-content">{{item.title || item.content}}</text>
              <view class="post-text-mask"></view>
            </view>
            <view class="post-content">
              <text wx:if="{{item.picList && item.picList.length > 0}}" class="post-title">{{item.title || item.content}}</text>
              <view class="post-footer">
                <view class="post-author">
                  <image wx:if="{{item.authorAvatar}}" class="author-avatar" src="{{item.authorAvatar}}"/>
                  <view wx:else class="author-avatar-text">{{item.authorName ? item.authorName[0] : 'U'}}</view>
                  <text class="author-name">{{item.authorName || '匿名用户'}}</text>
                </view>
                <view class="post-likes">
                  <text class="material-symbols-outlined like-icon {{item.isLiked ? 'active' : ''}}">pets</text>
                  <text class="like-count {{item.isLiked ? 'active' : ''}}">{{item.likeCount || 0}}</text>
                </view>
              </view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <!-- 底部加载更多 -->
    <view wx:if="{{!loading && posts.length > 0 && !noMore}}" class="loading-container">
      <view class="paw-loader">
        <text class="material-symbols-outlined paw-icon">pets</text>
      </view>
    </view>

    <view wx:if="{{noMore && posts.length > 0}}" class="loading-container">
      <text class="loading-text">已经到底啦~</text>
    </view>
  </view>

  <!-- 发布按钮 FAB -->
  <view class="fab-button" bindtap="goToPost">
    <text class="material-symbols-outlined fab-icon">add</text>
    <view class="fab-decoration">
      <text class="material-symbols-outlined">pets</text>
    </view>
  </view>

  <!-- 底部安全区域 -->
  <view class="safe-area-bottom"></view>
</view>
