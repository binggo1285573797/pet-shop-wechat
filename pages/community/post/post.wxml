<!--pages/community/post/post.wxml - Stitch 风格发布帖子页面-->
<view class="post-page">
  <!-- 顶部导航栏 -->
  <view class="post-header">
    <view class="header-left">
      <view class="back-btn" bindtap="goBack">
        <text class="material-symbols-outlined back-icon">arrow_back</text>
      </view>
      <text class="material-symbols-outlined header-icon">pets</text>
      <text class="header-title">{{isEdit ? '编辑帖子' : '爱宠家'}}</text>
    </view>
  </view>

  <!-- 主内容区 -->
  <scroll-view scroll-y class="post-content">
    <!-- 输入卡片 -->
    <view class="input-card">
      <input
        class="title-input"
        placeholder="填写标题（必填）"
        value="{{title}}"
        bindinput="onTitleInput"
      />
      <textarea
        class="content-textarea"
        placeholder="分享关于宠物的一切..."
        value="{{content}}"
        bindinput="onContentInput"
        maxlength="500"
        auto-height
      />
    </view>

    <!-- 图片上传网格 -->
    <view class="media-grid">
      <!-- 已上传图片 -->
      <view class="media-item" wx:for="{{images}}" wx:key="index">
        <image class="media-image" src="{{item}}" mode="aspectFill"/>
        <view class="media-delete" bindtap="removeImage" data-index="{{index}}">
          <text class="material-symbols-outlined">close</text>
        </view>
      </view>
      <!-- 上传按钮 -->
      <view class="upload-btn" wx:if="{{images.length < 9}}" bindtap="chooseImage">
        <text class="material-symbols-outlined upload-icon">photo_camera</text>
        <text class="upload-text">添加图片/视频</text>
      </view>
      <!-- 占位 -->
      <view 
        class="media-placeholder" 
        wx:for="{{9 - images.length - (images.length < 9 ? 1 : 0)}}" 
        wx:key="index"
      ></view>
    </view>

    <!-- 底部间距 -->
    <view style="height: 240rpx;"></view>
  </scroll-view>

  <!-- 底部固定操作栏 -->
  <view class="action-bar">
    <view class="submit-btn {{canPost ? 'active' : ''}}" bindtap="submitPost">
      <text>发布帖子</text>
    </view>
    <view class="action-options">
      <view class="action-option">
        <text class="material-symbols-outlined action-icon">visibility</text>
        <text class="action-text">所有人可见</text>
      </view>
      <view class="action-option">
        <text class="material-symbols-outlined action-icon">save</text>
        <text class="action-text">保存草稿</text>
      </view>
    </view>
  </view>
</view>
