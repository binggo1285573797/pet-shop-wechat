/* pages/community/post/post.wxss - Stitch 风格发布帖子页面 */

Page {
  background: #f9f9f9;
  min-height: 100vh;
}

/* 顶部导航栏 - 完全按照设计稿 */
.post-header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 48rpx;
  padding-top: var(--status-bar-height, 44rpx);
  background: rgba(249, 249, 249, 0.7);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 12rpx 32rpx rgba(159, 65, 34, 0.06);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: rgba(255, 138, 101, 0.1);
  margin-right: 8rpx;
  transition: all 0.2s ease;
}

.back-btn:active {
  background: rgba(255, 138, 101, 0.2);
  transform: scale(0.95);
}

.back-icon {
  font-size: 32rpx;
  color: #FF8A65;
}

.header-icon {
  font-size: 40rpx;
  color: #FF8A65;
  font-variation-settings: 'FILL' 1;
}

.header-title {
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: 36rpx;
  font-weight: 800;
  color: #FF8A65;
  letter-spacing: 2rpx;
}

/* 主内容区 */
.post-content {
  padding: calc(var(--status-bar-height, 44rpx) + 104rpx) 32rpx 240rpx;
}

/* 输入卡片 - 白色圆角卡片 */
.input-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 48rpx;
  margin-bottom: 48rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.02);
}

.title-input {
  width: 100%;
  font-family: 'Plus Jakarta Sans', sans-serif;
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1c1c;
  border: none;
  padding: 0;
  margin-bottom: 32rpx;
  background: transparent;
}

.title-input::placeholder {
  color: #ddc0b8;
}

.content-textarea {
  width: 100%;
  min-height: 320rpx;
  font-family: 'Be Vietnam Pro', sans-serif;
  font-size: 30rpx;
  color: #56423c;
  line-height: 1.6;
  border: none;
  padding: 0;
  background: transparent;
}

.content-textarea::placeholder {
  color: #ddc0b8;
}

/* 图片上传网格 - 3列 */
.media-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24rpx;
  margin-bottom: 48rpx;
}

.media-item {
  position: relative;
  aspect-ratio: 1;
  border-radius: 24rpx;
  overflow: hidden;
}

.media-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.media-delete {
  position: absolute;
  top: 12rpx;
  right: 12rpx;
  width: 48rpx;
  height: 48rpx;
  background: rgba(0, 0, 0, 0.4);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(4px);
}

.media-delete .material-symbols-outlined {
  font-size: 28rpx;
  color: #ffffff;
}

.upload-btn {
  aspect-ratio: 1;
  border-radius: 24rpx;
  border: 2rpx dashed rgba(255, 138, 101, 0.5);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: rgba(255, 138, 101, 0.05);
  transition: all 0.2s ease;
}

.upload-btn:active {
  background: rgba(255, 138, 101, 0.1);
}

.upload-icon {
  font-size: 56rpx;
  color: #FF8A65;
}

.upload-text {
  font-size: 24rpx;
  color: #FF8A65;
  font-weight: 500;
}

.media-placeholder {
  aspect-ratio: 1;
  border-radius: 24rpx;
  background: rgba(0, 0, 0, 0.02);
}

/* 话题选择 */
.topic-section {
  margin-bottom: 48rpx;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 8rpx;
  margin-bottom: 24rpx;
}

.section-icon {
  font-size: 36rpx;
  color: #FF8A65;
  font-variation-settings: 'FILL' 1;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #56423c;
}

.topic-scroll {
  white-space: nowrap;
}

.topic-list {
  display: inline-flex;
  gap: 24rpx;
  padding: 8rpx 0;
}

.topic-item {
  flex-shrink: 0;
  padding: 20rpx 40rpx;
  background: #e2e2e2;
  border-radius: 40rpx;
  transition: all 0.2s ease;
}

.topic-item.active {
  background: rgba(255, 138, 101, 0.1);
  border: 2rpx solid rgba(255, 138, 101, 0.2);
}

.topic-item text {
  font-size: 26rpx;
  font-weight: 600;
  color: #56423c;
}

.topic-item.active text {
  color: #FF8A65;
}

/* 底部固定操作栏 */
.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.8);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  padding: 48rpx 48rpx;
  padding-bottom: calc(48rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 24rpx rgba(0, 0, 0, 0.04);
  z-index: 50;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.submit-btn {
  width: 85%;
  max-width: 600rpx;
  height: 96rpx;
  background: #e8e8e8;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  transition: all 0.2s ease;
}

.submit-btn.active {
  background: linear-gradient(to right, #FF8A65, #ffb094);
  box-shadow: 0 12rpx 32rpx rgba(159, 65, 34, 0.2);
}

.submit-btn:active {
  transform: scale(0.95);
}

.submit-btn text {
  font-size: 32rpx;
  font-weight: 700;
  color: #a8a8a8;
}

.submit-btn.active text {
  color: #ffffff;
}

.action-options {
  display: flex;
  align-items: center;
  gap: 48rpx;
}

.action-option {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.action-icon {
  font-size: 28rpx;
  color: #a8a8a8;
}

.action-text {
  font-size: 24rpx;
  color: #a8a8a8;
}
