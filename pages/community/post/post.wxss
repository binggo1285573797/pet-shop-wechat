/* pages/community/post/post.wxss - 基于Stitch设计 */
.post-page {
  width: 100vw;
  min-height: 100vh;
  background: #fdfbf9;
  display: flex;
  flex-direction: column;
  position: relative;
}

/* TopAppBar */
.app-header {
  position: fixed;
  top: 0;
  width: 100%;
  height: 96rpx;
  background: #ffffff;
  z-index: 100;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  padding-top: env(safe-area-inset-top);
  border-bottom: 1rpx solid rgba(255, 138, 101, 0.1);
}

.header-row {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.back-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: flex-start;
}

.back-icon {
  font-size: 44rpx;
  color: #89726b;
}

.header-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1c1c;
  font-family: "Plus Jakarta Sans", sans-serif;
}

.post-btn {
  background: rgba(137, 114, 107, 0.2);
  color: #89726b;
  padding: 12rpx 28rpx;
  border-radius: 28rpx;
  font-size: 26rpx;
  font-weight: 700;
  font-family: "Plus Jakarta Sans", sans-serif;
  transition: all 0.3s ease;
}

.post-btn.active {
  background: linear-gradient(135deg, #ff8a65 0%, #ffab91 100%);
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(255, 138, 101, 0.3);
}

/* Post Scroll */
.post-scroll {
  flex: 1;
  margin-top: 96rpx;
  height: calc(100vh - 96rpx);
}

.post-container {
  padding: 48rpx 32rpx 60rpx;
  max-width: 750rpx;
  margin: 0 auto;
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

/* Section Label */
.section-label {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.label-icon {
  font-size: 32rpx;
  color: #ff8a65;
}

.section-label text:nth-child(2) {
  font-size: 30rpx;
  font-weight: 700;
  color: #56423c;
  font-family: "Plus Jakarta Sans", sans-serif;
}

.section-hint {
  font-size: 24rpx;
  color: #89726b;
  font-weight: 400;
}

/* Category Section */
.category-scroll {
  white-space: nowrap;
}

.category-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 8rpx 0;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 24rpx 32rpx;
  background: #ffffff;
  border-radius: 24rpx;
  border: 2rpx solid rgba(255, 138, 101, 0.1);
  transition: all 0.3s ease;
}

.category-item.active {
  background: linear-gradient(135deg, #ff8a65 0%, #ffab91 100%);
  border-color: transparent;
  box-shadow: 0 8rpx 24rpx rgba(255, 138, 101, 0.3);
}

.category-emoji {
  font-size: 40rpx;
}

.category-name {
  font-size: 24rpx;
  font-weight: 600;
  color: #56423c;
}

.category-item.active .category-name {
  color: #ffffff;
}

/* Content Section */
.content-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 24rpx 80rpx rgba(255, 138, 101, 0.06);
  border: 1rpx solid rgba(255, 138, 101, 0.05);
}

.content-textarea {
  width: 100%;
  min-height: 240rpx;
  font-size: 30rpx;
  color: #1a1c1c;
  line-height: 1.7;
  background: transparent;
  border: none;
}

.content-textarea::placeholder {
  color: rgba(137, 114, 107, 0.5);
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #89726b;
  margin-top: 16rpx;
}

/* Image Section */
.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  overflow: hidden;
  background: #f3f3f3;
}

.uploaded-img {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.remove-icon {
  font-size: 28rpx;
  color: #ffffff;
}

.image-add {
  width: 200rpx;
  height: 200rpx;
  border-radius: 24rpx;
  background: #ffffff;
  border: 2rpx dashed rgba(255, 138, 101, 0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  transition: all 0.3s ease;
}

.image-add:active {
  transform: scale(0.95);
}

.image-add.disabled {
  opacity: 0.5;
}

.add-icon {
  font-size: 56rpx;
  color: rgba(255, 138, 101, 0.5);
}

.add-text {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(255, 138, 101, 0.7);
}

/* Tags Section */
.tags-card {
  background: #ffffff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 24rpx 80rpx rgba(255, 138, 101, 0.06);
  border: 1rpx solid rgba(255, 138, 101, 0.05);
}

.tags-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.tag-input {
  flex: 1;
  background: #f3f3f3;
  border-radius: 24rpx;
  padding: 20rpx 28rpx;
  font-size: 28rpx;
  color: #1a1c1c;
}

.tag-input::placeholder {
  color: rgba(137, 114, 107, 0.5);
}

.add-tag-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff8a65 0%, #ffab91 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 138, 101, 0.3);
}

.add-tag-btn .material-symbols-outlined {
  font-size: 40rpx;
  color: #ffffff;
}

.tags-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 24rpx;
}

.tag-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 138, 101, 0.1);
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #ff8a65;
}

.tag-remove {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.tag-remove .material-symbols-outlined {
  font-size: 24rpx;
  color: rgba(255, 138, 101, 0.7);
}

/* Suggestions Section */
.suggestions-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.suggestion-item {
  padding: 16rpx 24rpx;
  background: #ffffff;
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 138, 101, 0.2);
  font-size: 26rpx;
  font-weight: 600;
  color: #ff8a65;
  transition: all 0.3s ease;
}

.suggestion-item:active {
  transform: scale(0.95);
  background: rgba(255, 138, 101, 0.1);
}

.bottom-spacer {
  height: 60rpx;
}

/* Decorative Blurs */
.blur-top-left {
  position: fixed;
  top: 25%;
  left: -160rpx;
  width: 320rpx;
  height: 320rpx;
  background: rgba(255, 138, 101, 0.05);
  border-radius: 50%;
  filter: blur(80rpx);
  z-index: -1;
}

.blur-bottom-right {
  position: fixed;
  bottom: 10%;
  right: -200rpx;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255, 138, 101, 0.08);
  border-radius: 50%;
  filter: blur(100rpx);
  z-index: -1;
}
