/* components/image-uploader/image-uploader.wxss */

.image-uploader {
  padding: 24rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 24rpx;
}

.image-item {
  position: relative;
  width: calc((100% - 48rpx) / 3);
  aspect-ratio: 1;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f5f5f5;
}

.image-preview {
  width: 100%;
  height: 100%;
}

.delete-btn {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-icon {
  font-size: 28rpx;
  color: #ffffff;
}

.upload-btn {
  width: calc((100% - 48rpx) / 3);
  aspect-ratio: 1;
  border-radius: 16rpx;
  border: 4rpx dashed #dddddd;
  background: #fafafa;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  transition: all 0.2s;
}

.upload-btn:active {
  background: #f0f0f0;
  border-color: #FF8A65;
}

.upload-btn.disabled {
  opacity: 0.5;
}

.upload-icon {
  font-size: 64rpx;
  color: #cccccc;
}

.upload-text {
  font-size: 24rpx;
  color: #999999;
}

.tips {
  margin-top: 24rpx;
}

.tips-text {
  font-size: 24rpx;
  color: #999999;
}
