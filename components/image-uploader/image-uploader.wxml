<view class="image-uploader">
  <!-- 图片列表 -->
  <view class="image-list" wx:if="{{images.length > 0}}">
    <view class="image-item" wx:for="{{images}}" wx:key="index">
      <image 
        class="image-preview" 
        src="{{baseUrl}}{{item.url}}" 
        mode="aspectFill"
        bindtap="previewImage"
        data-url="{{baseUrl}}{{item.url}}"
      />
      <!-- 删除按钮 -->
      <view class="delete-btn" bindtap="deleteImage" data-index="{{index}}" wx:if="{{!readonly}}">
        <text class="material-symbols-outlined delete-icon">close</text>
      </view>
    </view>
  </view>

  <!-- 上传按钮 -->
  <view 
    class="upload-btn {{images.length >= maxCount ? 'disabled' : ''}}" 
    wx:if="{{!readonly && images.length < maxCount}}"
    bindtap="chooseImage"
  >
    <text class="material-symbols-outlined upload-icon">add_photo_alternate</text>
    <text class="upload-text">{{uploadText}}</text>
  </view>

  <!-- 提示文字 -->
  <view class="tips" wx:if="{{showTips}}">
    <text class="tips-text">最多上传 {{maxCount}} 张图片</text>
  </view>
</view>
